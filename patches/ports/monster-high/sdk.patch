diff --git a/libs/video/tests/test_fp_bindings.c b/libs/video/tests/test_fp_bindings.c
new file mode 100644
index 0000000..4b934c8
--- /dev/null
+++ b/libs/video/tests/test_fp_bindings.c
@@ -0,0 +1,34 @@
+#define COBJMACROS
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <initguid.h>
+#include <stdio.h>
+#include <string.h>
+typedef unsigned int u32;
+#include "../rsx_fp_bindings.h"
+static int check(const char* source,u32 expected)
+{
+    ID3DBlob* blob=NULL; ID3DBlob* error=NULL;
+    HRESULT hr=D3DCompile(source,strlen(source),"fixture",NULL,NULL,"main","ps_5_0",0,0,&blob,&error);
+    if(error) {if(FAILED(hr))fputs((const char*)error->lpVtbl->GetBufferPointer(error),stderr);error->lpVtbl->Release(error);}
+    if(FAILED(hr)||!blob)return 0;
+    u32 mask=0;int known=rsx_fp_reflected_texture_mask(blob,&mask);
+    blob->lpVtbl->Release(blob);
+    if(!known||mask!=expected){fprintf(stderr,"mask=%X expected=%X known=%d\n",mask,expected,known);return 0;}
+    return 1;
+}
+int main(void)
+{
+    if(!check("Texture2D a:register(t0);Texture2D unused:register(t12);SamplerState s:register(s0);float4 main(float4 p:SV_POSITION):SV_TARGET{return a.Sample(s,p.xy);}",1))return 1;
+    if(!check("float4 main():SV_TARGET{return float4(1,0,0,1);}",0))return 2;
+    if(!check("Texture2D a:register(t3);Texture2D b:register(t15);SamplerState s:register(s0);float4 main(float4 p:SV_POSITION):SV_TARGET{return a.Sample(s,p.xy)+b.Sample(s,p.xy);}",0x8008))return 3;
+    u32 mask=0;
+    if(rsx_fp_reflected_texture_mask(NULL,&mask)||mask!=0xFFFF)return 4;
+    ID3DBlob* invalid=NULL;
+    if(FAILED(D3DCreateBlob(32,&invalid)))return 5;
+    memset(invalid->lpVtbl->GetBufferPointer(invalid),0,32);mask=0;
+    int known=rsx_fp_reflected_texture_mask(invalid,&mask);invalid->lpVtbl->Release(invalid);
+    if(known||mask!=0xFFFF)return 6;
+    puts("FP binding reflection: unused declaration, no texture, sparse units, unknown fallback PASS");
+    return 0;
+}
diff --git a/libs/video/tests/test_index_decode.c b/libs/video/tests/test_index_decode.c
new file mode 100644
index 0000000..b49549d
--- /dev/null
+++ b/libs/video/tests/test_index_decode.c
@@ -0,0 +1,31 @@
+#include "../rsx_index_decode.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+static uint32_t seed=1;
+static uint32_t random_word(void) { seed=seed*1664525u+1013904223u;return seed; }
+static uint32_t reference(const uint8_t* base, int small, uint32_t vb, uint32_t k)
+{
+    const uint8_t* p=base+(uint64_t)k*(small?2:4);
+    if(small)return ((((uint32_t)p[0]<<8)|p[1])+vb)&0xFFFFFu;
+    return ((((uint32_t)p[0]<<24)|((uint32_t)p[1]<<16)|((uint32_t)p[2]<<8)|p[3])+vb)&0xFFFFFu;
+}
+int main(void)
+{
+    uint8_t bytes[1024];uint32_t output[130];
+    for(unsigned trial=0;trial<10000;trial++) {
+        for(unsigned i=0;i<sizeof bytes;i++)bytes[i]=(uint8_t)random_word();
+        for(int small=0;small<2;small++) {
+            uint32_t vb=random_word(),first=random_word()%64,count=random_word()%129;
+            output[0]=0x12345678;output[count+1]=0x87654321;
+            rsx_decode_index_packet(bytes+1,small,vb,first,count,output+1);
+            assert(output[0]==0x12345678 && output[count+1]==0x87654321);
+            for(uint32_t i=0;i<count;i++)assert(output[i+1]==reference(bytes+1,small,vb,first+i));
+        }
+    }
+    memset(bytes,255,sizeof bytes);
+    rsx_decode_index_packet(bytes,0,1,0,1,output);assert(output[0]==0);
+    rsx_decode_index_packet(bytes,1,0xFFFF0001u,0,1,output);assert(output[0]==0);
+    rsx_decode_index_packet(NULL,0,0,0,0,NULL);
+    puts("index decode: 20000 randomized packets, unaligned input, base wrap, canaries and zero count passed");
+}
diff --git a/libs/video/tests/test_index_remap.c b/libs/video/tests/test_index_remap.c
new file mode 100644
index 0000000..e4eaaed
--- /dev/null
+++ b/libs/video/tests/test_index_remap.c
@@ -0,0 +1,54 @@
+#include "../rsx_index_remap.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint32_t stamps[1u << 20], slots[1u << 20];
+static uint32_t epoch;
+static void require(int value) { if (!value) { fprintf(stderr, "remap mismatch\n"); exit(1); } }
+static void check(const uint32_t* source, uint32_t count)
+{
+    uint32_t compact[1024], remap[1024];
+    require(count <= 1024);
+    memcpy(compact, source, count * 4);
+    if (++epoch == 0) { memset(stamps, 0, sizeof stamps); epoch = 1; }
+    uint32_t unique = rsx_index_remap(compact, count, remap, stamps, slots, epoch);
+    require(unique <= count);
+    for (uint32_t k = 0; k < count; ++k) {
+        require(remap[k] < unique);
+        require(compact[remap[k]] == source[k]);
+        /* Bitwise attribute identity for all compact slot widths. Include NaN
+         * bit patterns; these are bytes, not float comparisons. */
+        for (uint32_t slot = 0; slot < 16; ++slot)
+            for (uint32_t lane = 0; lane < 4; ++lane) {
+                uint32_t a = source[k] * 2654435761u ^ (slot * 4 + lane) ^ 0x7FC00000u;
+                uint32_t b = compact[remap[k]] * 2654435761u ^ (slot * 4 + lane) ^ 0x7FC00000u;
+                require(a == b);
+            }
+        /* Existing draw merging rebases each packet by previous vertex count. */
+        uint32_t base = 713;
+        require((remap[k] + base) - base < unique);
+        require(compact[(remap[k] + base) - base] == source[k]);
+    }
+}
+int main(int argc, char** argv)
+{
+    const uint32_t edge[] = {0, 0xFFFFF, 64, 0, 64, 0xFFFFF, 1};
+    check(edge, 7); check(edge, 7); check(edge, 0);
+    epoch = 0xFFFFFFFFu; check(edge, 7);
+    if (argc == 2) {
+        FILE* f = fopen(argv[1], "rb"); require(f != NULL);
+        uint32_t h[3], idx[1024], records = 0;
+        require(fread(h, 4, 2, f) == 2 && h[0] == 0x58444952 && h[1] == 1);
+        while (fread(h, 4, 3, f) == 3) {
+            require(h[1] >= 256 && h[1] < 1024 && h[2] >= 1 && h[2] <= 16);
+            require(fread(idx, 4, h[1], f) == h[1]);
+            for (uint32_t k = 0; k < h[1]; ++k) require(idx[k] < (1u << 20));
+            check(idx, h[1]); ++records;
+        }
+        require(feof(f) && records == 512); fclose(f);
+        printf("512 real packets: order and bit-pattern reconstruction passed\n");
+    }
+    puts("index remap edge/epoch tests passed");
+    return 0;
+}

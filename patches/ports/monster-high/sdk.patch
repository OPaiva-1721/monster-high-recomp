+/* The job dispatchers fingerprint the same SPU image on every job; FNV-1a is one dependent
+ * multiply per byte, so a 100 KB image costs ~0.1 ms. Remember the result per (address, size),
+ * validated by a quick 4-lane word hash of the bytes (an image rewritten in place changes it). */
+#define FP_CACHE_N 64
+typedef struct { const void* ptr; size_t n; uint64_t check, fp; } fp_cache_entry;
+static fp_cache_entry s_fp_cache[FP_CACHE_N];
+static volatile int s_fp_lock;
+
+static uint64_t fp_check(const uint8_t* p, size_t n)
+{
+    uint64_t a = 0x9E3779B97F4A7C15ULL, b = a ^ 1, c = a ^ 2, d = a ^ 3, w[4];
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        memcpy(w, p + i, 32);
+        a = (a ^ w[0]) * 0x100000001B3ULL; a ^= a >> 29;
+        b = (b ^ w[1]) * 0x100000001B3ULL; b ^= b >> 29;
+        c = (c ^ w[2]) * 0x100000001B3ULL; c ^= c >> 29;
+        d = (d ^ w[3]) * 0x100000001B3ULL; d ^= d >> 29;
+    }
+    for (; i < n; i++) a = (a ^ p[i]) * 0x100000001B3ULL;
+    return a ^ (b * 3) ^ (c * 5) ^ (d * 7) ^ n;

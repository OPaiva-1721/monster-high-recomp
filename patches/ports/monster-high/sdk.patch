--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -282,10 +282,23 @@ static int audio_backend_init(void)
     REFERENCE_TIME buf_duration = 200000; /* 20ms in 100ns units */
     s_wasapi_event = CreateEventW(NULL, FALSE, FALSE, NULL);
 
+    /* Shared mode accepts only the mixer's own format unless asked to
+     * convert: a device mixing at 44.1 kHz (or with more than two channels)
+     * rejected 48 kHz float stereo with AUDCLNT_E_UNSUPPORTED_FORMAT and the
+     * game ran silent. Let the audio engine resample and remap. */
+#ifndef AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM
+#define AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM 0x80000000
+#endif
+#ifndef AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY
+#define AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY 0x08000000
+#endif
+    const DWORD convert = AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM |
+                          AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY;
+
     hr = s_wasapi_client->lpVtbl->Initialize(
         s_wasapi_client,
         AUDCLNT_SHAREMODE_SHARED,
-        AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+        AUDCLNT_STREAMFLAGS_EVENTCALLBACK | convert,
         buf_duration, 0, &wfx, NULL);
 
     if (FAILED(hr)) {
@@ -293,7 +306,7 @@ static int audio_backend_init(void)
         hr = s_wasapi_client->lpVtbl->Initialize(
             s_wasapi_client,
             AUDCLNT_SHAREMODE_SHARED,
-            0, buf_duration, 0, &wfx, NULL);
+            convert, buf_duration, 0, &wfx, NULL);
         if (FAILED(hr)) {
             printf("[cellAudio] WASAPI Initialize failed: 0x%08lX\n", hr);
             s_wasapi_client->lpVtbl->Release(s_wasapi_client);
@@ -548,11 +561,40 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
      * With no device, pace on the performance counter instead. */
     LARGE_INTEGER qf, q0; QueryPerformanceFrequency(&qf); QueryPerformanceCounter(&q0);
     unsigned long long blocks = 0;
+    /* Space the blocks out. WASAPI's shared-mode event fires once per 10 ms
+     * period (~480 frames), and pacing on "room in the buffer" alone mixed two
+     * blocks back to back and then waited: the guest got one notify, wrote one
+     * block, and the second block of each pair was consumed (and cleared)
+     * before the guest woke again -- Naruto Storm's music played with every
+     * other 5.33 ms block silent. Keep the device's room as the rate source
+     * (pure clock pacing drifts against the device and underruns), but never
+     * mix a block sooner than 4 ms after the previous one; at that spacing the
+     * mixer can still deliver 2.5 blocks per period, ahead of the 1.875 the
+     * device consumes. */
+    HANDLE tmr = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */,
+                                        TIMER_ALL_ACCESS);
+    if (!tmr) tmr = CreateWaitableTimerW(NULL, TRUE, NULL);
+    /* The guest runs as many threads as it likes at normal priority; a mixer
+     * preempted for a few ms underruns the device. */
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    const long long min_gap = qf.QuadPart * 4 / 1000;
+    long long last_mix = 0;
     while (s_mix_thread_running) {
         const int room = audio_backend_room();
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
+        LARGE_INTEGER now; QueryPerformanceCounter(&now);
+        if (room >= 0 && last_mix && now.QuadPart - last_mix < min_gap) {
+            const long long left = min_gap - (now.QuadPart - last_mix);
+            if (tmr) {
+                LARGE_INTEGER dt;
+                dt.QuadPart = -(left * 10000000LL / qf.QuadPart);   /* 100 ns, relative */
+                if (dt.QuadPart > -1) dt.QuadPart = -1;
+                SetWaitableTimer(tmr, &dt, 0, NULL, NULL, FALSE);
+                WaitForSingleObject(tmr, 20);
+            } else Sleep(1);
+            continue;
+        }
         if (room < 0) {
-            LARGE_INTEGER now; QueryPerformanceCounter(&now);
             const long long due = q0.QuadPart +
                 (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
             if (now.QuadPart < due) { Sleep(1); continue; }
@@ -562,6 +604,7 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
                 q0.QuadPart = now.QuadPart -
                     (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
         }
+        last_mix = now.QuadPart;
         blocks++;
         /* Mix and submit one block */
         audio_mix_one_block();

diff --git a/libs/video/rsx_fp_bindings.h b/libs/video/rsx_fp_bindings.h
new file mode 100644
index 0000000..9cf27e0
--- /dev/null
+++ b/libs/video/rsx_fp_bindings.h
@@ -0,0 +1,26 @@
+/* Reflection of the compiled shader, not of texture state left bound by guest.
+ * Unknown reflection or an out-of-range binding conservatively keeps all units.
+ */
+#include <d3d12shader.h>
+static int rsx_fp_reflected_texture_mask(ID3DBlob* blob, u32* mask)
+{
+    *mask = 0xFFFFu;
+    ID3D12ShaderReflection* reflection = NULL;
+    if (!blob || FAILED(D3DReflect(blob->lpVtbl->GetBufferPointer(blob),
+            blob->lpVtbl->GetBufferSize(blob), &IID_ID3D12ShaderReflection,
+            (void**)&reflection)) || !reflection) return 0;
+    D3D12_SHADER_DESC desc;
+    int valid = SUCCEEDED(reflection->lpVtbl->GetDesc(reflection,&desc));
+    u32 used = 0;
+    for (UINT i=0;valid && i<desc.BoundResources;++i) {
+        D3D12_SHADER_INPUT_BIND_DESC binding;
+        if (FAILED(reflection->lpVtbl->GetResourceBindingDesc(reflection,i,&binding))) {valid=0;break;}
+        if (binding.Type == D3D_SIT_CBUFFER || binding.Type == D3D_SIT_SAMPLER) continue;
+        if (binding.Type != D3D_SIT_TEXTURE) {valid=0;break;}
+        if (binding.Space || !binding.BindCount || binding.BindPoint>=16 || binding.BindCount>16-binding.BindPoint) {valid=0;break;}
+        used |= ((1u<<binding.BindCount)-1u)<<binding.BindPoint;
+    }
+    reflection->lpVtbl->Release(reflection);
+    if (valid) *mask=used;
+    return valid;
+}
diff --git a/libs/video/rsx_game_capture.c b/libs/video/rsx_game_capture.c
new file mode 100644
index 0000000..49b5a2a
--- /dev/null
+++ b/libs/video/rsx_game_capture.c
@@ -0,0 +1,215 @@
+/* Diagnostic capture only: no FIFO decoding and no renderer changes here.
+ * Windows snapshots cover EVERY committed readable guest page (not just IO),
+ * so aliased main/local offsets, transfers and raw guest-EA fallbacks survive.
+ * Writes are streamed; a footer and atomic rename distinguish complete files.
+ */
+#include "rsx_game_capture.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <inttypes.h>
+
+int rsx_game_capture_enabled;
+int rsx_game_capture_recording;
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+extern uint8_t* vm_base;
+static FILE* output;
+static char *destination, *partial;
+static const char* trigger;
+static uint64_t target, flips, commands, snapshots;
+static int pending, closing, done;
+static uint8_t *shadow, *valid;
+static rsx_game_capture_meta previous_meta;
+static int have_meta;
+
+static void fail(const char* reason)
+{
+    fprintf(stderr, "[game-cap] ERROR: %s (partial kept if created)\n", reason);
+    if (output) fclose(output);
+    output = NULL;
+    if (shadow) VirtualFree(shadow, 0, MEM_RELEASE);
+    free(valid); shadow = valid = NULL;
+    rsx_game_capture_enabled = rsx_game_capture_recording = 0;
+    done = 1;
+}
+static int write_bytes(const void* p, size_t size)
+{
+    if (!output) return 0;
+    if (fwrite(p, 1, size, output) != size) { fail("capture write failed"); return 0; }
+    return 1;
+}
+static int record(uint32_t kind, const void* p, uint32_t size)
+{
+    const uint32_t header[2] = {kind, size};
+    return write_bytes(header, sizeof header) && (!size || write_bytes(p, size));
+}
+static int memory(uint32_t ea, const void* p, uint32_t size)
+{
+    uint32_t header[3] = {GCAP_MEMORY, size + 4, ea};
+    return write_bytes(header, sizeof header) && write_bytes(p, size);
+}
+static int readable(DWORD protection)
+{
+    if (protection & (PAGE_GUARD | PAGE_NOACCESS)) return 0;
+    switch (protection & 255) {
+    case PAGE_READONLY: case PAGE_READWRITE: case PAGE_WRITECOPY:
+    case PAGE_EXECUTE_READ: case PAGE_EXECUTE_READWRITE: case PAGE_EXECUTE_WRITECOPY: return 1;
+    default: return 0;
+    }
+}
+static int snapshot(void)
+{
+    rsx_game_capture_meta meta;
+    cellGcm_game_capture_meta(&meta);
+    if (!have_meta || memcmp(&meta, &previous_meta, sizeof meta)) {
+        if (!record(GCAP_META, &meta, sizeof meta)) return 0;
+        previous_meta = meta; have_meta = 1;
+    }
+    /* Each page is copied once to a temporary before comparison/output: the
+     * recorded bytes and shadow agree even if a guest CPU writes concurrently.
+     * We do not suspend guest threads or change guest page protections. */
+    for (uint64_t ea = 0; ea < 0x100000000ull;) {
+        MEMORY_BASIC_INFORMATION info;
+        if (!VirtualQuery(vm_base + ea, &info, sizeof info)) {
+            fail("VirtualQuery failed"); return 0;
+        }
+        uint64_t end = (uint8_t*)info.BaseAddress - vm_base + info.RegionSize;
+        if (end > 0x100000000ull) end = 0x100000000ull;
+        if (end <= ea) { fail("invalid guest VM region"); return 0; }
+        if (info.State == MEM_COMMIT && readable(info.Protect)) {
+            if (!VirtualAlloc(shadow + ea, (SIZE_T)(end - ea), MEM_COMMIT, PAGE_READWRITE)) {
+                fail("cannot commit capture shadow"); return 0;
+            }
+            for (; ea < end; ea += 4096) {
+                uint8_t bytes[4096];
+                SIZE_T copied = 0;
+                if (!ReadProcessMemory(GetCurrentProcess(), vm_base + ea, bytes, sizeof bytes, &copied) || copied != sizeof bytes) {
+                    fail("guest mapping changed during snapshot"); return 0;
+                }
+                if (!valid[ea / 4096] || memcmp(bytes, shadow + ea, sizeof bytes)) {
+                    if (!memory((uint32_t)ea, bytes, sizeof bytes)) return 0;
+                    memcpy(shadow + ea, bytes, sizeof bytes);
+                    valid[ea / 4096] = 1;
+                }
+            }
+        } else {
+            /* Recommitted pages must be emitted even if their old bytes match. */
+            memset(valid + ea / 4096, 0, (size_t)((end - ea) / 4096));
+            ea = end;
+        }
+    }
+    ++snapshots;
+    return record(GCAP_CHECKPOINT, &snapshots, sizeof snapshots);
+}
+static void begin(const rsx_state* state)
+{
+    if (!pending || done) return;
+    pending = 0;
+    if (!vm_base) { fail("capture requires a reserved guest vm_base"); return; }
+    if (GetFileAttributesA(destination) != INVALID_FILE_ATTRIBUTES) {
+        fail("GAME_CAP already exists; choose a new file"); return;
+    }
+    output = fopen(partial, "wbx");
+    if (!output) { fail("cannot exclusively create GAME_CAP.partial"); return; }
+    setvbuf(output, NULL, _IOFBF, 1024 * 1024);
+    shadow = VirtualAlloc(NULL, 0x100000000ull, MEM_RESERVE, PAGE_READWRITE);
+    valid = calloc(0x100000, 1);
+    if (!shadow || !valid) { fail("cannot allocate capture shadow"); return; }
+    const uint32_t header[6] = {0x50414347u, GCAP_VERSION, GCAP_ENDIAN,
+                               sizeof(rsx_state), sizeof(rsx_game_capture_meta), 0};
+    const uint64_t frame = flips + 1;
+    rsx_game_capture_recording = 1;
+    if (!write_bytes(header, sizeof header) || !write_bytes(&frame, sizeof frame) ||
+        !record(GCAP_STATE, state, sizeof *state) || !snapshot()) return;
+    fprintf(stderr, "[game-cap] recording frame %" PRIu64 " -> %s\n", frame, partial);
+}
+void rsx_game_capture_init(void)
+{
+    static int initialized;
+    if (initialized) return;
+    initialized = 1;
+    const char* path = getenv("GAME_CAP");
+    if (!path || !*path) return;
+    destination = _strdup(path);
+    partial = malloc(strlen(path) + 9);
+    if (!destination || !partial) { fail("out of memory"); return; }
+    sprintf(partial, "%s.partial", path);
+    trigger = getenv("GAME_CAP_TRIGGER");
+    const char* frame = getenv("GAME_CAP_FRAME");
+    if (frame && *frame) {
+        char* end;
+        errno = 0; target = _strtoui64(frame, &end, 10);
+        if (errno || *end || *frame == '-' || !target) { fail("invalid GAME_CAP_FRAME (use >=1)"); return; }
+    } else if (!trigger || !*trigger) target = 2;
+    pending = target == 1;
+    rsx_game_capture_enabled = 1;
+    fprintf(stderr, "[game-cap] armed: frame=%" PRIu64 " trigger=%s\n", target, trigger ? trigger : "(none)");
+}
+static void before(const rsx_state* state)
+{
+    /* A backend that does not submit at this flip cannot produce a complete
+     * port capture; do not silently mix commands from the next frame. */
+    if (closing) { fail("next frame arrived before D3D12 submitted the captured flip"); return; }
+    if (!rsx_game_capture_recording) begin(state);
+}
+void rsx_game_capture_method(const rsx_state* state, uint32_t method, uint32_t value)
+{
+    before(state);
+    if (!rsx_game_capture_recording) return;
+    /* Vertex/index/FP reads happen while processing draws; texture reads can
+     * happen later at SUBMIT. Preserve both versions, without END look-ahead. */
+    if (method == 0x1814 || method == 0x1824 || method == 0x1808 || method == 0x1d94)
+        if (!snapshot()) return;
+    const uint32_t pair[2] = {method, value};
+    if (record(GCAP_METHOD, pair, sizeof pair)) ++commands;
+}
+void rsx_game_capture_transfer(const rsx_state* state, uint32_t method, uint32_t value)
+{
+    before(state);
+    if (!rsx_game_capture_recording) return;
+    /* Record pre-transfer sources; the following draw/submit checkpoint also
+     * records the actual port's transfer result. Replay uses those bytes. */
+    if ((method & 0x1ffc) >= 0x400 && (method & 0x1ffc) <= 0x7fc)
+        if (!snapshot()) return;
+    const uint32_t pair[2] = {method, value};
+    record(GCAP_TRANSFER, pair, sizeof pair);
+}
+void rsx_game_capture_flip(uint32_t buffer)
+{
+    ++flips;
+    if (rsx_game_capture_recording) {
+        if (record(GCAP_FLIP, &buffer, sizeof buffer)) closing = 1;
+        return;
+    }
+    if (done || pending) return;
+    if (target == flips + 1 || (trigger && *trigger && GetFileAttributesA(trigger) != INVALID_FILE_ATTRIBUTES))
+        pending = 1; /* first method after this flip begins a complete frame */
+}
+void rsx_game_capture_submit(void)
+{
+    if (!rsx_game_capture_recording || !snapshot() || !record(GCAP_SUBMIT, NULL, 0)) return;
+    if (!closing) return;
+    const uint64_t footer[2] = {commands, snapshots};
+    if (!record(GCAP_END, footer, sizeof footer)) return;
+    int bad = fflush(output) != 0;
+    if (fclose(output)) bad = 1;
+    output = NULL;
+    if (bad || rename(partial, destination)) { fail("cannot finalize capture"); return; }
+    fprintf(stderr, "[game-cap] saved %s (%" PRIu64 " methods, %" PRIu64 " snapshots)\n", destination, commands, snapshots);
+    VirtualFree(shadow, 0, MEM_RELEASE); free(valid); shadow = valid = NULL;
+    rsx_game_capture_enabled = rsx_game_capture_recording = 0;
+    done = 1;
+}
+#else
+void rsx_game_capture_init(void) {
+    if (getenv("GAME_CAP")) fprintf(stderr, "[game-cap] Windows/D3D12 capture required\n");
+}
+void rsx_game_capture_method(const rsx_state* s, uint32_t m, uint32_t v) {(void)s;(void)m;(void)v;}
+void rsx_game_capture_transfer(const rsx_state* s, uint32_t m, uint32_t v) {(void)s;(void)m;(void)v;}
+void rsx_game_capture_flip(uint32_t b) {(void)b;}
+void rsx_game_capture_submit(void) {}
+#endif
diff --git a/libs/video/rsx_game_capture.h b/libs/video/rsx_game_capture.h
new file mode 100644
index 0000000..79eee47
--- /dev/null
+++ b/libs/video/rsx_game_capture.h
@@ -0,0 +1,47 @@
+/* GCAP v1: ordered, post-walker game capture. See docs/RRC_REPLAY.md. */
+#ifndef RSX_GAME_CAPTURE_H
+#define RSX_GAME_CAPTURE_H
+#include "rsx_commands.h"
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define GCAP_VERSION 1u
+#define GCAP_ENDIAN 0x12345678u
+#define GCAP_STATE 1u
+#define GCAP_META 2u
+#define GCAP_MEMORY 3u
+#define GCAP_METHOD 4u
+#define GCAP_TRANSFER 5u
+#define GCAP_FLIP 6u
+#define GCAP_SUBMIT 7u
+#define GCAP_END 8u
+#define GCAP_CHECKPOINT 9u
+
+/* All fields have fixed width; no host pointers. EA pages are exactly the
+ * port's translation table, including unmapped/zero entries and local hints.
+ * Tile/zcull arrays include the port's decoded fields and bound flag. */
+typedef struct rsx_game_capture_meta {
+    uint32_t local_address, local_size, inject_base, display_id;
+    uint32_t displays[8][5]; /* set, width, height, pitch, offset */
+    uint32_t tiles[15][9];   /* tile,limit,pitch,format,offset,size,base,bank,bound */
+    uint32_t zculls[8][12];  /* offset,width,height,cullStart,zFormat,aaFormat,
+                              zcullDir,zcullFormat,sFunc,sRef,sMask,bound */
+    uint16_t ea_pages[65536];
+    uint8_t local_pages[1024];
+} rsx_game_capture_meta;
+
+/* One predictable flag check in each hook. No getenv, file polling, memory
+ * scanning, allocation or callback when disabled. Init runs once per walker. */
+extern int rsx_game_capture_enabled;
+extern int rsx_game_capture_recording;
+void rsx_game_capture_init(void);
+void rsx_game_capture_method(const rsx_state*, uint32_t method, uint32_t value);
+void rsx_game_capture_transfer(const rsx_state*, uint32_t method, uint32_t value);
+void rsx_game_capture_flip(uint32_t buffer);
+void rsx_game_capture_submit(void);
+void cellGcm_game_capture_meta(rsx_game_capture_meta*);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_gpu_timing.h b/libs/video/rsx_gpu_timing.h
new file mode 100644
index 0000000..69e64d9
--- /dev/null
+++ b/libs/video/rsx_gpu_timing.h
@@ -0,0 +1,111 @@
+/* Opt-in live GPU timestamps. Included after s_d3d; no additional GPU waits.
+ * Query readback happens only after render_frame's existing completed fence.
+ * Draw timestamps perturb scheduling: diagnostic attribution, not a benchmark.
+ */
+#define GT_PAIRS (MAX_DRAWS * 3 + 8)
+#define GT_QUERIES (2 * GT_PAIRS + 2)
+static ID3D12QueryHeap* s_gt_heap;
+static ID3D12Resource* s_gt_readback;
+static struct { u32 fp; int rt; } s_gt_keys[GT_PAIRS];
+static u32 s_gt_pairs, s_gt_pending_pairs, s_gt_batches;
+static int s_gt_active, s_gt_pending, s_gt_disabled;
+static UINT64 s_gt_frequency;
+
+static void gpu_timing_release(void)
+{
+    if (s_gt_readback) s_gt_readback->lpVtbl->Release(s_gt_readback);
+    if (s_gt_heap) s_gt_heap->lpVtbl->Release(s_gt_heap);
+    s_gt_readback = NULL; s_gt_heap = NULL;
+    s_gt_active = s_gt_pending = 0;
+}
+
+static void gpu_timing_collect(void)
+{
+    if (!s_gt_pending) return;
+    s_gt_pending = 0;
+    /* The caller has already waited for all earlier queue submissions. */
+    u32 fi = s_d3d.frame_index;
+    if (s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence) < s_d3d.fence_values[fi] ||
+        FAILED(s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device))) {
+        fprintf(stderr, "[GPU-TIME] incomplete fence/device error; diagnostic disabled\n");
+        s_gt_disabled = 1; return;
+    }
+    UINT64* values = NULL;
+    D3D12_RANGE read = {0, (SIZE_T)GT_QUERIES * sizeof(UINT64)};
+    if (FAILED(s_gt_readback->lpVtbl->Map(s_gt_readback, 0, &read, (void**)&values))) {
+        fprintf(stderr, "[GPU-TIME] readback map failed\n"); s_gt_disabled = 1; return;
+    }
+    struct { u32 fp; int rt; double ms; u32 draws; } groups[GT_PAIRS];
+    u32 count = 0; double draw_ms = 0;
+    u32 end = 1 + 2 * s_gt_pending_pairs;
+    int valid = values[end] >= values[0];
+    for (u32 i = 0; i < s_gt_pending_pairs; ++i) {
+        UINT64 begin = values[1 + 2*i], finish = values[2 + 2*i];
+        if (finish < begin || begin < values[0] || finish > values[end]) { valid = 0; break; }
+        double ms = (double)(finish - begin) * 1000.0 / (double)s_gt_frequency;
+        draw_ms += ms;
+        u32 g = 0;
+        while (g < count && (groups[g].fp != s_gt_keys[i].fp || groups[g].rt != s_gt_keys[i].rt)) ++g;
+        if (g == count) { groups[g].fp=s_gt_keys[i].fp; groups[g].rt=s_gt_keys[i].rt; groups[g].ms=0; groups[g].draws=0; ++count; }
+        groups[g].ms += ms; ++groups[g].draws;
+    }
+    double total = valid ? (double)(values[end] - values[0]) * 1000.0 / (double)s_gt_frequency : 0;
+    D3D12_RANGE written = {0,0};
+    s_gt_readback->lpVtbl->Unmap(s_gt_readback,0,&written);
+    if (!valid) { fprintf(stderr,"[GPU-TIME] nonmonotonic query result; sample rejected\n"); return; }
+    fprintf(stderr,"[GPU-TIME] batch=%u total_ms=%.3f measured_ms=%.3f other_ms=%.3f sections=%u capped=%d\n",
+            s_gt_batches,total,draw_ms,total-draw_ms,s_gt_pending_pairs,s_gt_pending_pairs==GT_PAIRS);
+    for (u32 rank=0; rank<8 && rank<count; ++rank) {
+        u32 best=rank;
+        for(u32 g=rank+1;g<count;++g) if(groups[g].ms>groups[best].ms) best=g;
+        if(best!=rank) { u32 fp=groups[rank].fp, n=groups[rank].draws; int rt=groups[rank].rt; double ms=groups[rank].ms;
+            groups[rank]=groups[best]; groups[best].fp=fp;groups[best].rt=rt;groups[best].ms=ms;groups[best].draws=n; }
+        fprintf(stderr,"[GPU-TIME] batch=%u rank=%u fp=%08X rt=%d ms=%.3f draws=%u\n",
+                s_gt_batches,rank+1,groups[rank].fp,groups[rank].rt,groups[rank].ms,groups[rank].draws);
+    }
+}
+
+static void gpu_timing_begin(void)
+{
+    static int enabled=-1, after=250;
+    static ULONGLONG epoch;
+    if(enabled<0) { const char* e=getenv("RSX_GPU_TIMING"); enabled=e && *e=='1';
+        e=getenv("RSX_GPU_TIMING_AFTER"); if(e) after=atoi(e); epoch=GetTickCount64(); }
+    s_gt_active=0;
+    if(!enabled || s_gt_disabled || s_gt_batches>=40 || GetTickCount64()-epoch < (ULONGLONG)(after<0?0:after)*1000) return;
+    if(!s_gt_heap) {
+        D3D12_QUERY_HEAP_DESC q={0}; q.Type=D3D12_QUERY_HEAP_TYPE_TIMESTAMP; q.Count=GT_QUERIES;
+        HRESULT hr=s_d3d.device->lpVtbl->CreateQueryHeap(s_d3d.device,&q,&IID_ID3D12QueryHeap,(void**)&s_gt_heap);
+        D3D12_HEAP_PROPERTIES hp={0};hp.Type=D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rd={0};rd.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;rd.Width=GT_QUERIES*sizeof(UINT64);
+        rd.Height=1;rd.DepthOrArraySize=1;rd.MipLevels=1;rd.SampleDesc.Count=1;rd.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if(SUCCEEDED(hr)) hr=s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device,&hp,D3D12_HEAP_FLAG_NONE,&rd,D3D12_RESOURCE_STATE_COPY_DEST,NULL,&IID_ID3D12Resource,(void**)&s_gt_readback);
+        if(SUCCEEDED(hr)) hr=s_d3d.cmd_queue->lpVtbl->GetTimestampFrequency(s_d3d.cmd_queue,&s_gt_frequency);
+        if(FAILED(hr) || !s_gt_frequency) { fprintf(stderr,"[GPU-TIME] initialization failed hr=%08lX\n",(long)hr);gpu_timing_release();s_gt_disabled=1;return; }
+    }
+    s_gt_pairs=0;s_gt_active=1;++s_gt_batches;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list,s_gt_heap,D3D12_QUERY_TYPE_TIMESTAMP,0);
+}
+static void gpu_timing_section_begin(u32 key,int rt)
+{
+    if(!s_gt_active || s_gt_pairs>=GT_PAIRS)return;
+    s_gt_keys[s_gt_pairs].fp=key;s_gt_keys[s_gt_pairs].rt=rt;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list,s_gt_heap,D3D12_QUERY_TYPE_TIMESTAMP,1+2*s_gt_pairs);
+}
+static void gpu_timing_draw_begin(const D3D12DrawRecord* dr,int rt)
+{
+    gpu_timing_section_begin(dr->fp_addr,rt);
+}
+static void gpu_timing_draw_end(void)
+{
+    if(!s_gt_active || s_gt_pairs>=GT_PAIRS)return;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list,s_gt_heap,D3D12_QUERY_TYPE_TIMESTAMP,2+2*s_gt_pairs);++s_gt_pairs;
+}
+static void gpu_timing_finish(void)
+{
+    if(!s_gt_active)return;
+    u32 end=1+2*s_gt_pairs;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list,s_gt_heap,D3D12_QUERY_TYPE_TIMESTAMP,end);
+    s_d3d.cmd_list->lpVtbl->ResolveQueryData(s_d3d.cmd_list,s_gt_heap,D3D12_QUERY_TYPE_TIMESTAMP,0,end+1,s_gt_readback,0);
+    s_gt_pending_pairs=s_gt_pairs;s_gt_pending=1;s_gt_active=0;
+}
diff --git a/libs/video/rsx_index_decode.h b/libs/video/rsx_index_decode.h
new file mode 100644
index 0000000..fd26c19
--- /dev/null
+++ b/libs/video/rsx_index_decode.h
@@ -0,0 +1,19 @@
+#ifndef RSX_INDEX_DECODE_H
+#define RSX_INDEX_DECODE_H
+#include <stdint.h>
+
+/* Same unsigned addition/wrap and big-endian loads as read_guest_index.
+ * The caller resolves the index buffer location once for this packet. */
+static void rsx_decode_index_packet(const uint8_t* base, int is_u16,
+                                     uint32_t vertex_base, uint32_t first,
+                                     uint32_t count, uint32_t* output)
+{
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t k = first + i;
+        const uint8_t* p = base + (uint64_t)k * (is_u16 ? 2u : 4u);
+        const uint32_t raw = is_u16 ? ((uint32_t)p[0] << 8) | p[1]
+            : ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+        output[i] = (raw + vertex_base) & 0xFFFFFu;
+    }
+}
+#endif
diff --git a/libs/video/rsx_index_remap.h b/libs/video/rsx_index_remap.h
new file mode 100644
index 0000000..c24007d
--- /dev/null
+++ b/libs/video/rsx_index_remap.h
@@ -0,0 +1,24 @@
+#ifndef RSX_INDEX_REMAP_H
+#define RSX_INDEX_REMAP_H
+#include <stdint.h>
+
+/* Stable packet-local compaction. Input is already resolved in the RSX 20-bit
+ * vertex domain. Keep every index, including degenerates and partial triangles;
+ * adjacent packets can form one triangle stream. Caller owns epoch rollover. */
+static uint32_t rsx_index_remap(uint32_t* indices, uint32_t count,
+                                uint32_t* remap, uint32_t* stamps,
+                                uint32_t* slots, uint32_t epoch)
+{
+    uint32_t unique = 0;
+    for (uint32_t k = 0; k < count; ++k) {
+        const uint32_t id = indices[k];
+        if (stamps[id] != epoch) {
+            stamps[id] = epoch;
+            slots[id] = unique;
+            indices[unique++] = id;
+        }
+        remap[k] = slots[id];
+    }
+    return unique;
+}
+#endif
diff --git a/libs/video/rsx_present_samples.h b/libs/video/rsx_present_samples.h
new file mode 100644
index 0000000..f39f581
--- /dev/null
+++ b/libs/video/rsx_present_samples.h
@@ -0,0 +1,36 @@
+#ifndef RSX_PRESENT_SAMPLES_H
+#define RSX_PRESENT_SAMPLES_H
+#include <stdint.h>
+#define RSX_PRESENT_SAMPLE_CAP 8192
+typedef struct rsx_present_sample {
+    double begin, end;
+    double render_entry, gpu_wait_end;
+    uint32_t batch, draws;
+    int32_t result;
+} rsx_present_sample;
+typedef struct rsx_present_sample_buffer {
+    rsx_present_sample rows[RSX_PRESENT_SAMPLE_CAP];
+    uint32_t count, rejected, capped;
+} rsx_present_sample_buffer;
+static void rsx_present_sample_add(rsx_present_sample_buffer* buffer, double begin,
+                                    double end, uint32_t batch, uint32_t draws, int32_t result)
+{
+    if (!(begin > 0.0) || !(end >= begin) ||
+        (buffer->count && begin < buffer->rows[buffer->count-1].end)) {
+        buffer->rejected++; return;
+    }
+    if (buffer->count == RSX_PRESENT_SAMPLE_CAP) { buffer->capped++; return; }
+    rsx_present_sample* row=&buffer->rows[buffer->count++];
+    row->begin=begin; row->end=end; row->batch=batch; row->draws=draws; row->result=result;
+    row->render_entry=row->gpu_wait_end=0.0;
+}
+static void rsx_present_sample_set_phase(rsx_present_sample_buffer* buffer, double render_entry, double gpu_wait_end)
+{
+    if (!buffer->count) { buffer->rejected++; return; }
+    rsx_present_sample* row=&buffer->rows[buffer->count-1];
+    if (!(render_entry > 0.0 && gpu_wait_end >= render_entry && row->begin >= gpu_wait_end)) {
+        buffer->rejected++; return;
+    }
+    row->render_entry=render_entry;row->gpu_wait_end=gpu_wait_end;
+}
+#endif

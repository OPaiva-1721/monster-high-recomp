+static void off_rt_snapshot_impl(int rt)
+{
+    OffRT* r = &s_d3d.off_rt[rt];
+    if (!r->copy) return;
+    off_rt_transition(rt, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    BENCH_COUNT(self_copies);
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r->copy;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = r->copy_st;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, r->copy, r->res);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    r->copy_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;

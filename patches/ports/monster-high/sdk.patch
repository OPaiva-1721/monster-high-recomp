+    for (u32 b = 0; b < 16; ++b) if (input_mask & (1u << b)) plan->bit[plan->nslots++] = (u8)b;
+    for (u32 i = 0; i < 16; ++i) {
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!(input_mask & (1u << i)) || !a->enabled || !a->stride || !vm_base) continue;
+        u32 j = plan->count++;
+        plan->arrays[j].slot = i;
+        { u32 r = 0; for (u32 b = 0; b < i; ++b) if (input_mask & (1u << b)) ++r; plan->arrays[j].crank = r; }
+        plan->arrays[j].offset = (a->offset & 0x7FFFFFFFu) + st->vertex_data_base_offset;
+        plan->arrays[j].local = !(a->offset & 0x80000000u);
+        /* Keep arithmetic in u32: guest offsets and EAs wrap at 32 bits. */
+        plan->arrays[j].resolved_base = cellGcmResolveLocated(plan->arrays[j].local,
+                                                             plan->arrays[j].offset);
+        plan->arrays[j].stride = a->stride;
+        plan->arrays[j].type = a->type;
+        plan->arrays[j].size = a->size ? a->size : 4;
+        if (plan->arrays[j].size > 4) plan->arrays[j].size = 4;
+        { static int tdbg = -1; static unsigned long long seen[16];
+          if (tdbg < 0) tdbg = getenv("VTXTYPES") ? 1 : 0;
+          if (tdbg) { u32 key = (plan->arrays[j].type & 7u) * 8u + plan->arrays[j].size;
+              if (!(seen[i] & (1ull << key)) ) { seen[i] |= 1ull << key;
+                  fprintf(stderr, "[VTXTYPES] attr %u type %u size %u stride %u freq %u%c", i, plan->arrays[j].type,
+                          plan->arrays[j].size, plan->arrays[j].stride, a->frequency, 10); } } }
+        plan->arrays[j].frequency = !nofreq && a->frequency > 1 ? a->frequency : 1;
+        plan->arrays[j].modulo = !!(st->frequency_divider_op & (1u << i));
+        plan->defaults[i][0] = plan->defaults[i][1] = plan->defaults[i][2] = 0;
+        plan->defaults[i][3] = 1;
+    }
+    for (u32 r = 0; r < plan->nslots; ++r) memcpy(plan->cdefaults[r], plan->defaults[plan->bit[r]], 16);
+}
+
+void rsx_fetch_vertex_planned(const rsx_vp_fetch_plan* plan, u32 vi, float out[16][4])
+{
+    memcpy(out, plan->defaults, sizeof(plan->defaults));
+    for (u32 j = 0; j < plan->count; ++j) {
+        u32 ei = vi, freq = plan->arrays[j].frequency;
+        if (freq > 1) ei = plan->arrays[j].modulo ? vi % freq : vi / freq;
+        u32 off = plan->arrays[j].offset + ei * plan->arrays[j].stride;
+        u32 ea = plan->arrays[j].local || !((off ^ plan->arrays[j].offset) >> 20)
+            ? plan->arrays[j].resolved_base + (off - plan->arrays[j].offset)
+            : cellGcmResolveLocated(0, off);
+        const u8* p = vm_base + ea;
+        decode_array(plan->arrays[j].type, plan->arrays[j].size, p,
+                     out[plan->arrays[j].slot], plan->arrays[j].slot,
+                     plan->arrays[j].size, plan->arrays[j].stride);
+    }
+}
+
+static void fetch_vertices_block(const rsx_vp_fetch_plan* plan, u32 first, u32 count,
+                                 float (*out)[16][4])
+{
+    if (!count) return;
+    for (u32 i = 0; i < count; ++i) memcpy(out[i],plan->defaults,sizeof(plan->defaults));
+    for (u32 j = 0; j < plan->count; ++j) {
+        const rsx_vp_fetch_array* a = &plan->arrays[j];
+        u32 page = a->offset >> 20, base = a->resolved_base - a->offset;
+        /* The constant TYPE folds decode_array's switch outside the vertex
+         * loop even with /Ob1. Refresh MAIN translation at every IO page
+         * change; resolve the START of each element, like the scalar path. */
+#define DECODE_RUN(TYPE) do { \
+        for (u32 i = 0; i < count; ++i) { \
+            u32 vi = first + i, ei = vi; \
+            if (a->frequency > 1) ei = a->modulo ? vi % a->frequency : vi / a->frequency; \
+            u32 off = a->offset + ei * a->stride; \
+            if (!a->local && (off >> 20) != page) { \
+                page = off >> 20; base = cellGcmResolveLocated(0,off) - off; \
+            } \
+            decode_array(TYPE,a->size,vm_base + (u32)(base + off), \
+                         out[i][a->slot],a->slot,a->size,a->stride); \
+        } \
+    } while (0)
+        switch (a->type) {
+        case 1: DECODE_RUN(1); break;
+        case 2: DECODE_RUN(2); break;
+        case 3: DECODE_RUN(3); break;
+        case 4: DECODE_RUN(4); break;
+        case 5: DECODE_RUN(5); break;
+        case 6: DECODE_RUN(6); break;
+        case 7: DECODE_RUN(7); break;
+        default: DECODE_RUN(a->type); break;
         }
-        break;
-    case 5: /* S32K: s16 integer */
-        for (u32 k = 0; k < n; k++)
-            out[k] = (float)(s16)((p[k*2] << 8) | p[k*2+1]);
-        break;
-    case 7: /* UB256: u8 unnormalized */
-        for (u32 k = 0; k < n; k++) out[k] = (float)p[k];
-        break;
-    default:
-        { static int t = -1; if (t < 0) t = getenv("VTX_TYPEDBG") ? 1 : 0;
-          if (t) { static u32 seen = 0;
-              if (!(seen & (1u << (a->type & 31)))) { seen |= 1u << (a->type & 31);
-                  fprintf(stderr, "[VTXTYPE] UNHANDLED type=%u attr=%d size=%u stride=%u\n",
-                          a->type, idx, a->size, a->stride); } } }
-        for (u32 k = 0; k < n; k++) out[k] = rsx_rd_bef(p + k * 4);
-        break;
+#undef DECODE_RUN
+    }
+}
+
+void rsx_fetch_vertices_planned(const rsx_vp_fetch_plan* plan, u32 first, u32 count,
+                               float (*out)[16][4])
+{
+    /* D3D12 upload heaps are write-combined. Array-wise strided stores there
+     * lose to the old vertex-wise writes even when decode itself is faster.
+     * Stage a bounded block in cached RAM, then write each upload byte once
+     * with a linear copy. No reads or partial-slot rewrites of upload memory. */
+    float decoded[64][16][4];
+    while (count) {
+        u32 n = count < 64 ? count : 64;
+        fetch_vertices_block(plan,first,n,decoded);
+        memcpy(out,decoded,n*sizeof(decoded[0]));
+        out += n; first += n; count -= n;
+    }
+}
+
+void rsx_fetch_vertex_compact(const rsx_vp_fetch_plan* plan, u32 vi, float (*out)[4])
+{
+    rsx_copy_slots(out, plan->cdefaults, plan->nslots);
+    for (u32 j = 0; j < plan->count; ++j) {
+        const rsx_vp_fetch_array* a = &plan->arrays[j];
+        u32 ei = vi;
+        if (a->frequency > 1) ei = a->modulo ? vi % a->frequency : vi / a->frequency;
+        u32 off = a->offset + ei * a->stride;
+        u32 ea = a->local || !((off ^ a->offset) >> 20)
+            ? a->resolved_base + (off - a->offset)
+            : cellGcmResolveLocated(0, off);
+        decode_array(a->type, a->size, vm_base + ea, out[a->crank], a->slot, a->size, a->stride);
+    }
+}
+
+static void fetch_vertices_block_compact(const rsx_vp_fetch_plan* plan, u32 first, u32 count, float* out)
+{
+    const u32 ns = plan->nslots;
+    if (!count) return;
+    for (u32 i = 0; i < count; ++i) rsx_copy_slots(out + (size_t)i * ns * 4, plan->cdefaults, ns);
+    for (u32 j = 0; j < plan->count; ++j) {
+        const rsx_vp_fetch_array* a = &plan->arrays[j];
+        u32 page = a->offset >> 20, base = a->resolved_base - a->offset;
+#define DECODE_RUN_C(TYPE) do { \
+        for (u32 i = 0; i < count; ++i) { \
+            u32 vi = first + i, ei = vi; \
+            if (a->frequency > 1) ei = a->modulo ? vi % a->frequency : vi / a->frequency; \
+            u32 off = a->offset + ei * a->stride; \
+            if (!a->local && (off >> 20) != page) { \
+                page = off >> 20; base = cellGcmResolveLocated(0,off) - off; \
+            } \
+            decode_array(TYPE,a->size,vm_base + (u32)(base + off), \
+                         out + (size_t)i * ns * 4 + a->crank * 4,a->slot,a->size,a->stride); \
+        } \
+    } while (0)
+        switch (a->type) {
+        case 1: DECODE_RUN_C(1); break;
+        case 2: DECODE_RUN_C(2); break;
+        case 3: DECODE_RUN_C(3); break;
+        case 4: DECODE_RUN_C(4); break;
+        case 5: DECODE_RUN_C(5); break;
+        case 6: DECODE_RUN_C(6); break;
+        case 7: DECODE_RUN_C(7); break;
+        default: DECODE_RUN_C(a->type); break;
+        }
+#undef DECODE_RUN_C
     }
 }
+
+void rsx_fetch_vertices_compact(const rsx_vp_fetch_plan* plan, u32 first, u32 count, float* out)
+{
+    /* Same staging as rsx_fetch_vertices_planned: decode a bounded block in cached RAM, then one
+     * linear copy into the (write-combined) upload memory. */
+    float decoded[64 * 16 * 4];
+    const u32 ns = plan->nslots;
+    while (count) {
+        u32 n = count < 64 ? count : 64;
+        fetch_vertices_block_compact(plan, first, n, decoded);
+        memcpy(out, decoded, (size_t)n * ns * 16u);
+        out += (size_t)n * ns * 4; first += n; count -= n;
+    }
+}
+
+static void gather_block(const rsx_vp_fetch_plan* plan, const u32* idx, u32 count, float* out)
+{
+    const u32 ns = plan->nslots;
+    for (u32 i = 0; i < count; ++i) rsx_copy_slots(out + (size_t)i * ns * 4, plan->cdefaults, ns);
+    for (u32 j = 0; j < plan->count; ++j) {
+        const rsx_vp_fetch_array* a = &plan->arrays[j];
+        u32 page = a->offset >> 20, base = a->resolved_base - a->offset;
+#define GATHER_RUN(TYPE) do { \
+        for (u32 i = 0; i < count; ++i) { \
+            u32 vi = idx[i], ei = vi; \
+            if (a->frequency > 1) ei = a->modulo ? vi % a->frequency : vi / a->frequency; \
+            u32 off = a->offset + ei * a->stride; \
+            if (!a->local && (off >> 20) != page) { \
+                page = off >> 20; base = cellGcmResolveLocated(0,off) - off; \
+            } \
+            decode_array(TYPE,a->size,vm_base + (u32)(base + off), \
+                         out + (size_t)i * ns * 4 + a->crank * 4,a->slot,a->size,a->stride); \
+        } \
+    } while (0)
+        switch (a->type) {
+        case 1: GATHER_RUN(1); break;
+        case 2: GATHER_RUN(2); break;
+        case 3: GATHER_RUN(3); break;
+        case 4: GATHER_RUN(4); break;
+        case 5: GATHER_RUN(5); break;
+        case 6: GATHER_RUN(6); break;
+        case 7: GATHER_RUN(7); break;
+        default: GATHER_RUN(a->type); break;
+        }
+#undef GATHER_RUN
+    }
+}
+
+void rsx_fetch_vertices_gather(const rsx_vp_fetch_plan* plan, const u32* idx, u32 count, float* out)
+{
+    float decoded[64 * 16 * 4];
+    const u32 ns = plan->nslots;
+    while (count) {
+        u32 n = count < 64 ? count : 64;
+        gather_block(plan, idx, n, decoded);
+        memcpy(out, decoded, (size_t)n * ns * 16u);
+        out += (size_t)n * ns * 4; idx += n; count -= n;
+    }
+}
+
+#ifdef _WIN32
+#define RSX_PAR_MAX 8
+static struct {
+    void (*fn)(void*, u32); void* ctx;
+    volatile LONG n, next, done;
+    int nworkers; HANDLE go[RSX_PAR_MAX]; HANDLE all_done;
+    volatile LONG state;               /* 0 none, 1 creating, 2 ready, 3 off */
+    SRWLOCK lock;                      /* one parallel region at a time */
+} s_par = { .lock = SRWLOCK_INIT };
+
+static void rsx_par_run_some(void)
+{
+    for (;;) {
+        LONG i = _InterlockedIncrement(&s_par.next) - 1;
+        if (i >= s_par.n) return;
+        s_par.fn(s_par.ctx, (u32)i);
+        if (_InterlockedIncrement(&s_par.done) == s_par.n) SetEvent(s_par.all_done);
+    }
+}
+static DWORD WINAPI rsx_par_worker(LPVOID p)
+{
+    int w = (int)(intptr_t)p;
+    for (;;) { WaitForSingleObject(s_par.go[w], INFINITE); rsx_par_run_some(); }
+    return 0;
+}
+int rsx_par_workers(void)
+{
+    static int want = -2;
+    if (want == -2) {
+        const char* e = getenv("RSX_PAR");
+        SYSTEM_INFO si; GetSystemInfo(&si);
+        want = e ? atoi(e) : (si.dwNumberOfProcessors >= 8 ? 4 : si.dwNumberOfProcessors >= 4 ? 2 : 0);
+        if (want > RSX_PAR_MAX) want = RSX_PAR_MAX;
+        if (want < 2) want = 0;
+    }
+    if (!want) return 0;
+    if (s_par.state == 2) return s_par.nworkers;
+    if (s_par.state == 0 && _InterlockedCompareExchange(&s_par.state, 1, 0) == 0) {
+        s_par.all_done = CreateEventA(NULL, FALSE, FALSE, NULL);
+        int ok = s_par.all_done != NULL;
+        s_par.nworkers = want;
+        for (int w = 0; ok && w < want - 1; w++) {       /* the caller is worker #want */
+            s_par.go[w] = CreateEventA(NULL, FALSE, FALSE, NULL);
+            HANDLE th = s_par.go[w] ? CreateThread(NULL, 1u << 20, rsx_par_worker, (LPVOID)(intptr_t)w, 0, NULL) : NULL;
+            if (th) CloseHandle(th); else ok = 0;
+        }
+        _InterlockedExchange(&s_par.state, ok ? 2 : 3);
+        if (ok) fprintf(stderr, "[rsx] RSX_PAR: %d threads for vertex decode\n", want);
+    }
+    while (s_par.state == 1) SwitchToThread();
+    return s_par.state == 2 ? s_par.nworkers : 0;
+}
+void rsx_par_for(void (*fn)(void*, u32), void* ctx, u32 nchunks)
+{
+    if (!rsx_par_workers() || nchunks < 2) { for (u32 i = 0; i < nchunks; i++) fn(ctx, i); return; }
+    AcquireSRWLockExclusive(&s_par.lock);
+    s_par.fn = fn; s_par.ctx = ctx;
+    s_par.n = (LONG)nchunks; s_par.next = 0; s_par.done = 0;
+    for (int w = 0; w < s_par.nworkers - 1; w++) SetEvent(s_par.go[w]);
+    rsx_par_run_some();
+    while (s_par.done < (LONG)nchunks) WaitForSingleObject(s_par.all_done, 1);
+    ReleaseSRWLockExclusive(&s_par.lock);
+}
+#else
+int rsx_par_workers(void) { return 0; }
+void rsx_par_for(void (*fn)(void*, u32), void* ctx, u32 nchunks)
+{
+    for (u32 i = 0; i < nchunks; i++) fn(ctx, i);
+}
+#endif

diff --git a/libs/input/pad_pc_profile.h b/libs/input/pad_pc_profile.h
new file mode 100644
index 0000000..41c89f5
--- /dev/null
+++ b/libs/input/pad_pc_profile.h
@@ -0,0 +1,160 @@
+#ifndef PS3RECOMP_PAD_PC_PROFILE_H
+#define PS3RECOMP_PAD_PC_PROFILE_H
+
+#include "cellPad.h"
+#include <ctype.h>
+#include <math.h>
+#include <stddef.h>
+#include <string.h>
+
+typedef enum PadPcAction {
+    PAD_PC_UP, PAD_PC_DOWN, PAD_PC_LEFT, PAD_PC_RIGHT,
+    PAD_PC_CROSS, PAD_PC_CIRCLE, PAD_PC_SQUARE, PAD_PC_TRIANGLE,
+    PAD_PC_L1, PAD_PC_R1, PAD_PC_L2, PAD_PC_R2,
+    PAD_PC_START, PAD_PC_SELECT, PAD_PC_L3, PAD_PC_R3,
+    PAD_PC_ACTION_COUNT
+} PadPcAction;
+
+typedef struct PadPcConfig {
+    int move_keys[4][2];
+    int button_keys[16][2];
+    float sensitivity;
+    int invert_y;
+    int mouse_enabled;
+    int capture_key;
+} PadPcConfig;
+
+typedef struct PadPcOutput {
+    u16 buttons;
+    u8 lx, ly, rx, ry, l2, r2;
+} PadPcOutput;
+
+static inline void pad_pc_defaults(PadPcConfig* c) {
+    static const int buttons[16][2] = {
+        {0x26,0},{0x28,0},{0x25,0},{0x27,0},
+        {0x20,0},{1,0},{2,0},{'E',0},
+        {'Q',0},{'R',0},{0x10,0},{0x11,0},
+        {0x1b,0x0d},{0x09,0},{0,0},{0,0}
+    };
+    memset(c, 0, sizeof(*c));
+    c->move_keys[0][0] = 'W'; c->move_keys[1][0] = 'S';
+    c->move_keys[2][0] = 'A'; c->move_keys[3][0] = 'D';
+    memcpy(c->button_keys, buttons, sizeof(buttons));
+    c->sensitivity = 0.08f;
+    c->mouse_enabled = 1;
+    c->capture_key = 0x70;
+}
+
+static inline int pad_pc_key_from_name(const char* name) {
+    char word[16];
+    size_t n = 0;
+    if (!name) return -1;
+    while (isspace((unsigned char)*name)) ++name;
+    while (*name && !isspace((unsigned char)*name)) {
+        if (n + 1 >= sizeof(word)) return -1;
+        word[n++] = (char)toupper((unsigned char)*name++);
+    }
+    while (isspace((unsigned char)*name)) ++name;
+    if (*name || !n) return -1;
+    word[n] = 0;
+    if (n == 1 && ((word[0] >= 'A' && word[0] <= 'Z') ||
+                   (word[0] >= '0' && word[0] <= '9'))) return word[0];
+    if (!strcmp(word,"NONE")) return 0;
+    if (!strcmp(word,"SPACE")) return 0x20;
+    if (!strcmp(word,"ENTER")) return 0x0d;
+    if (!strcmp(word,"ESC")) return 0x1b;
+    if (!strcmp(word,"TAB")) return 0x09;
+    if (!strcmp(word,"SHIFT")) return 0x10;
+    if (!strcmp(word,"CTRL")) return 0x11;
+    if (!strcmp(word,"ALT")) return 0x12;
+    if (!strcmp(word,"UP")) return 0x26;
+    if (!strcmp(word,"DOWN")) return 0x28;
+    if (!strcmp(word,"LEFT")) return 0x25;
+    if (!strcmp(word,"RIGHT")) return 0x27;
+    if (word[0] == 'F' && n >= 2 && n <= 3) {
+        int v = 0;
+        size_t i;
+        for (i = 1; i < n; ++i) {
+            if (word[i] < '0' || word[i] > '9') return -1;
+            v = v * 10 + word[i] - '0';
+        }
+        return v >= 1 && v <= 12 ? 0x6f + v : -1;
+    }
+    if (n == 6 && !memcmp(word,"MOUSE",5) && word[5] >= '1' && word[5] <= '5') {
+        static const int mouse_vk[5] = {1,2,4,5,6};
+        return mouse_vk[word[5] - '1'];
+    }
+    return -1;
+}
+
+static inline int pad_pc_parse_binding(const char* text, int out[2]) {
+    char part[32];
+    int value[2] = {0,0};
+    int count = 0;
+    if (!text || !out) return 0;
+    do {
+        size_t n = 0;
+        if (count == 2) return 0;
+        while (*text && *text != ',') {
+            if (n + 1 >= sizeof(part)) return 0;
+            part[n++] = *text++;
+        }
+        part[n] = 0;
+        value[count] = pad_pc_key_from_name(part);
+        if (value[count] < 0) return 0;
+        ++count;
+        if (!*text) break;
+        ++text;
+        if (!*text) return 0;
+    } while (1);
+    out[0] = value[0]; out[1] = value[1];
+    return 1;
+}
+
+static inline int pad_pc_pressed(const int binding[2], const unsigned char keys[256]) {
+    return (binding[0] > 0 && binding[0] < 256 && keys[binding[0]]) ||
+           (binding[1] > 0 && binding[1] < 256 && keys[binding[1]]);
+}
+
+static inline int pad_pc_stick_delta(float delta, float seconds, float sensitivity) {
+    float v;
+    if (!isfinite(delta) || !isfinite(seconds) || seconds <= 0 ||
+        !isfinite(sensitivity) || sensitivity <= 0) return 0;
+    if (sensitivity > 10.0f) sensitivity = 10.0f;
+    v = (delta / seconds) * sensitivity;
+    if (v >= 127.0f) return 127;
+    if (v <= -127.0f) return -127;
+    return (int)roundf(v);
+}
+
+static inline void pad_pc_evaluate(const PadPcConfig* c, const unsigned char keys[256],
+                                    float dx, float dy, float seconds, PadPcOutput* out) {
+    static const u16 bits[16] = {
+        CELL_PAD_CTRL_UP,CELL_PAD_CTRL_DOWN,CELL_PAD_CTRL_LEFT,CELL_PAD_CTRL_RIGHT,
+        CELL_PAD_CTRL_CROSS,CELL_PAD_CTRL_CIRCLE,CELL_PAD_CTRL_SQUARE,CELL_PAD_CTRL_TRIANGLE,
+        CELL_PAD_CTRL_L1,CELL_PAD_CTRL_R1,CELL_PAD_CTRL_L2,CELL_PAD_CTRL_R2,
+        CELL_PAD_CTRL_START,CELL_PAD_CTRL_SELECT,CELL_PAD_CTRL_L3,CELL_PAD_CTRL_R3
+    };
+    int i, x, y;
+    memset(out, 0, sizeof(*out));
+    out->lx = out->ly = out->rx = out->ry = 128;
+    for (i = 0; i < PAD_PC_ACTION_COUNT; ++i)
+        if (pad_pc_pressed(c->button_keys[i], keys)) out->buttons |= bits[i];
+    out->l2 = (out->buttons & CELL_PAD_CTRL_L2) ? 255 : 0;
+    out->r2 = (out->buttons & CELL_PAD_CTRL_R2) ? 255 : 0;
+    x = pad_pc_pressed(c->move_keys[3], keys) - pad_pc_pressed(c->move_keys[2], keys);
+    y = pad_pc_pressed(c->move_keys[1], keys) - pad_pc_pressed(c->move_keys[0], keys);
+    if (x && y) {
+        out->lx = (u8)(128 + x * 90);
+        out->ly = (u8)(128 + y * 90);
+    } else {
+        out->lx = (u8)(128 + x * 127);
+        out->ly = (u8)(128 + y * 127);
+    }
+    if (c->mouse_enabled) {
+        out->rx = (u8)(128 + pad_pc_stick_delta(dx, seconds, c->sensitivity));
+        out->ry = (u8)(128 + pad_pc_stick_delta(c->invert_y ? -dy : dy, seconds, c->sensitivity));
+    }
+}
+
+#endif
diff --git a/libs/input/pad_pc_win32.h b/libs/input/pad_pc_win32.h
new file mode 100644
index 0000000..53354a7
--- /dev/null
+++ b/libs/input/pad_pc_win32.h
@@ -0,0 +1,303 @@
+#ifndef PS3RECOMP_PAD_PC_WIN32_H
+#define PS3RECOMP_PAD_PC_WIN32_H
+
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "pad_pc_profile.h"
+
+/* Only the host adapter touches the cursor. The profile/math module is pure. */
+static SRWLOCK s_pc_lock = SRWLOCK_INIT;
+static volatile LONG s_pc_pending[8];
+static struct {
+    PadPcConfig config;
+    int initialized, enabled, focused, allow_capture;
+    int toggle_down, start_down, block_mouse_buttons;
+    volatile LONG captured;
+    POINT center;
+    RECT clip;
+    ULONGLONG last_ms;
+    ULONGLONG report_ms;
+    float mouse_dx, mouse_dy, observed_dx, observed_dy;
+    HWND window;
+    LONG observed[8];
+    unsigned char physical_keys[256];
+} s_pc_win;
+
+static void pad_pc_win_release_locked(void)
+{
+    if (InterlockedExchange(&s_pc_win.captured, 0)) {
+        ClipCursor(NULL);
+        SetCursor(LoadCursor(NULL, IDC_ARROW));
+    }
+    s_pc_win.last_ms = 0;
+    s_pc_win.report_ms = 0;
+    s_pc_win.mouse_dx = s_pc_win.mouse_dy = 0;
+    s_pc_win.observed_dx = s_pc_win.observed_dy = 0;
+}
+
+static int pad_pc_win_value(const char* path, const char* section, const char* key, char value[256])
+{
+    DWORD n = GetPrivateProfileStringA(section, key, "", value, 256, path);
+    if (n == 255) {
+        fprintf(stderr, "[cellPad] ignored oversized [%s] %s\n", section, key);
+        return 0;
+    }
+    return n != 0;
+}
+
+static void pad_pc_win_init_locked(void)
+{
+    if (s_pc_win.initialized) return;
+    s_pc_win.initialized = 1;
+    const char* profile = getenv("PAD_PROFILE");
+#ifdef PS3RECOMP_PAD_DEFAULT_NARUTO_PC
+    s_pc_win.enabled = 1;
+#endif
+    if (profile && *profile) s_pc_win.enabled = !_stricmp(profile, "naruto-pc");
+    if (getenv("PAD_NO_KEYBOARD")) s_pc_win.enabled = 0;
+    if (!s_pc_win.enabled) return;
+    pad_pc_defaults(&s_pc_win.config);
+    s_pc_win.allow_capture = 1;
+    s_pc_win.block_mouse_buttons = 1;
+    char path[MAX_PATH], value[256];
+    const char* custom = getenv("PAD_CONFIG");
+    if (custom && *custom) {
+        DWORD n = GetFullPathNameA(custom, MAX_PATH, path, NULL);
+        if (!n || n >= MAX_PATH) path[0] = 0;
+    } else {
+        DWORD n = GetModuleFileNameA(NULL, path, MAX_PATH);
+        if (!n || n >= MAX_PATH) path[0] = 0;
+        char* slash = strrchr(path, '\\');
+        if (slash && (size_t)(slash + 1 - path) + sizeof("naruto-controls.ini") <= MAX_PATH)
+            strcpy(slash + 1, "naruto-controls.ini");
+        else path[0] = 0;
+    }
+    static const char* moves[] = {"forward", "backward", "left", "right"};
+    static const char* buttons[] = {
+        "up", "down", "left", "right", "cross", "circle", "square", "triangle",
+        "l1", "r1", "l2", "r2", "start", "select", "l3", "r3"
+    };
+    if (*path) {
+        for (int i = 0; i < 4; ++i)
+            if (pad_pc_win_value(path, "move", moves[i], value) &&
+                !pad_pc_parse_binding(value, s_pc_win.config.move_keys[i]))
+                fprintf(stderr, "[cellPad] ignored invalid [move] %s\n", moves[i]);
+        for (int i = 0; i < PAD_PC_ACTION_COUNT; ++i)
+            if (pad_pc_win_value(path, "buttons", buttons[i], value) &&
+                !pad_pc_parse_binding(value, s_pc_win.config.button_keys[i]))
+                fprintf(stderr, "[cellPad] ignored invalid [buttons] %s\n", buttons[i]);
+        if (pad_pc_win_value(path, "mouse", "capture_key", value)) {
+            int k = pad_pc_key_from_name(value);
+            if (k > 0) s_pc_win.config.capture_key = k;
+            else fprintf(stderr, "[cellPad] ignored invalid mouse capture_key\n");
+        }
+        if (pad_pc_win_value(path, "mouse", "sensitivity", value)) {
+            char* end;
+            double gain = strtod(value, &end);
+            while (isspace((unsigned char)*end)) ++end;
+            if (end != value && !*end && isfinite(gain) && gain >= .001 && gain <= 2)
+                s_pc_win.config.sensitivity = (float)gain;
+            else fprintf(stderr, "[cellPad] ignored invalid mouse sensitivity\n");
+        }
+        const char* flags[] = {"enabled", "invert_y"};
+        for (int i = 0; i < 2; ++i) if (pad_pc_win_value(path, "mouse", flags[i], value)) {
+            if (!strcmp(value, "0") || !strcmp(value, "1")) {
+                if (i == 0) s_pc_win.config.mouse_enabled = value[0] == '1';
+                else s_pc_win.config.invert_y = value[0] == '1';
+            } else fprintf(stderr, "[cellPad] ignored invalid [mouse] %s\n", flags[i]);
+        }
+    }
+    printf("[cellPad] naruto-pc controls; config=%s; camera toggle configurable (F1 default)\n",
+           *path ? path : "defaults");
+}
+
+static int pad_pc_win_enabled(void)
+{
+    AcquireSRWLockExclusive(&s_pc_lock);
+    pad_pc_win_init_locked();
+    int result = s_pc_win.enabled;
+    ReleaseSRWLockExclusive(&s_pc_lock);
+    return result;
+}
+
+static int pad_pc_win_captured(void)
+{
+    return InterlockedCompareExchange(&s_pc_win.captured, 0, 0) != 0;
+}
+
+static void pad_pc_win_focus_lost(void)
+{
+    AcquireSRWLockExclusive(&s_pc_lock);
+    pad_pc_win_release_locked();
+    s_pc_win.focused = 0;
+    s_pc_win.block_mouse_buttons = 1;
+    for (int i = 0; i < 8; ++i) InterlockedExchange(&s_pc_pending[i], 0);
+    ReleaseSRWLockExclusive(&s_pc_lock);
+}
+
+static void pad_pc_win_set_window(HWND window)
+{
+    pad_pc_win_focus_lost();
+    AcquireSRWLockExclusive(&s_pc_lock);
+    s_pc_win.window = window;
+    ReleaseSRWLockExclusive(&s_pc_lock);
+}
+
+static void pad_pc_win_key_pressed(unsigned key)
+{
+    AcquireSRWLockExclusive(&s_pc_lock);
+    if (key > 0 && key < 256)
+        InterlockedOr(&s_pc_pending[key / 32], (LONG)(1u << (key % 32)));
+    ReleaseSRWLockExclusive(&s_pc_lock);
+}
+
+/* The caller holds the lock through delivery to guest memory. */
+static void pad_pc_win_evaluate_locked(PadPcOutput* out)
+{
+    memset(out, 0, sizeof(*out));
+    out->lx = out->ly = out->rx = out->ry = 128;
+    memset(s_pc_win.observed, 0, sizeof(s_pc_win.observed));
+    s_pc_win.observed_dx = s_pc_win.observed_dy = 0;
+    if (!s_pc_win.enabled || !s_pc_win.focused) return;
+    unsigned char keys[256];
+    memcpy(keys, s_pc_win.physical_keys, sizeof(keys));
+    for (int i = 0; i < 8; ++i) {
+        s_pc_win.observed[i] = InterlockedCompareExchange(&s_pc_pending[i], 0, 0);
+        for (int bit = 0; bit < 32; ++bit)
+            keys[i * 32 + bit] |= ((unsigned long)s_pc_win.observed[i] >> bit) & 1u;
+    }
+    if (s_pc_win.block_mouse_buttons) {
+        keys[VK_LBUTTON] = keys[VK_RBUTTON] = keys[VK_MBUTTON] = 0;
+        keys[VK_XBUTTON1] = keys[VK_XBUTTON2] = 0;
+    }
+    ULONGLONG now = GetTickCount64();
+    if (!s_pc_win.report_ms) s_pc_win.report_ms = now;
+    s_pc_win.observed_dx = s_pc_win.mouse_dx;
+    s_pc_win.observed_dy = s_pc_win.mouse_dy;
+    pad_pc_evaluate(&s_pc_win.config, keys, s_pc_win.mouse_dx, s_pc_win.mouse_dy,
+        (float)(now - s_pc_win.report_ms) / 1000.f, out);
+}
+
+static void pad_pc_win_begin_report(PadPcOutput* out)
+{
+    AcquireSRWLockExclusive(&s_pc_lock);
+    if (GetForegroundWindow() != s_pc_win.window) {
+        pad_pc_win_release_locked();
+        s_pc_win.focused = 0;
+        memset(s_pc_win.physical_keys, 0, sizeof(s_pc_win.physical_keys));
+        for (int i = 0; i < 8; ++i) InterlockedExchange(&s_pc_pending[i], 0);
+    }
+    pad_pc_win_evaluate_locked(out);
+}
+
+static void pad_pc_win_end_report(int delivered)
+{
+    if (delivered) {
+        for (int i = 0; i < 8; ++i)
+            InterlockedAnd(&s_pc_pending[i], ~s_pc_win.observed[i]);
+        s_pc_win.mouse_dx -= s_pc_win.observed_dx;
+        s_pc_win.mouse_dy -= s_pc_win.observed_dy;
+        s_pc_win.observed_dx = s_pc_win.observed_dy = 0;
+        s_pc_win.report_ms = GetTickCount64();
+    }
+    ReleaseSRWLockExclusive(&s_pc_lock);
+}
+
+static void pad_pc_win_poll(PadPcOutput* out)
+{
+    memset(out, 0, sizeof(*out));
+    out->lx = out->ly = out->rx = out->ry = 128;
+    AcquireSRWLockExclusive(&s_pc_lock);
+    pad_pc_win_init_locked();
+    HWND window = GetForegroundWindow();
+    DWORD pid = 0;
+    if (window) GetWindowThreadProcessId(window, &pid);
+    if (!s_pc_win.enabled || !s_pc_win.window || window != s_pc_win.window || pid != GetCurrentProcessId()) {
+        pad_pc_win_release_locked();
+        s_pc_win.focused = 0;
+        s_pc_win.block_mouse_buttons = 1;
+        for (int i = 0; i < 8; ++i) InterlockedExchange(&s_pc_pending[i], 0);
+        ReleaseSRWLockExclusive(&s_pc_lock);
+        return;
+    }
+    unsigned char keys[256] = {0}, checked[256] = {0};
+    for (int i = 0; i < 8; ++i)
+        s_pc_win.observed[i] = InterlockedCompareExchange(&s_pc_pending[i], 0, 0);
+    for (int i = 0; i < 4 + PAD_PC_ACTION_COUNT; ++i) {
+        const int* binding = i < 4 ? s_pc_win.config.move_keys[i] : s_pc_win.config.button_keys[i - 4];
+        for (int j = 0; j < 2; ++j) {
+            int k = binding[j];
+            if (k > 0 && k < 256 && !checked[k]) {
+                keys[k] = (GetAsyncKeyState(k) & 0x8000) != 0 ||
+                          (((unsigned long)s_pc_win.observed[k / 32] >> (k % 32)) & 1u);
+                checked[k] = 1;
+            }
+        }
+    }
+    for (int k = 0; k < 256; ++k)
+        s_pc_win.physical_keys[k] = checked[k] && ((GetAsyncKeyState(k) & 0x8000) != 0);
+    int capture_key = s_pc_win.config.capture_key;
+    int toggle_event = ((unsigned long)InterlockedAnd(&s_pc_pending[capture_key / 32],
+                        (LONG)~(1u << (capture_key % 32))) >> (capture_key % 32)) & 1u;
+    int toggle = (GetAsyncKeyState(capture_key) & 0x8000) != 0;
+    int start = pad_pc_pressed(s_pc_win.config.button_keys[PAD_PC_START], keys);
+    int start_event = 0;
+    for (int i = 0; i < 2; ++i) {
+        int k = s_pc_win.config.button_keys[PAD_PC_START][i];
+        if (k > 0) start_event |= ((unsigned long)s_pc_win.observed[k / 32] >> (k % 32)) & 1u;
+    }
+    int warmup = !s_pc_win.focused;
+    s_pc_win.focused = 1;
+    if (warmup) { s_pc_win.toggle_down = toggle; s_pc_win.start_down = start; }
+    if (toggle_event || (toggle && !s_pc_win.toggle_down)) {
+        s_pc_win.allow_capture = !s_pc_win.allow_capture;
+        s_pc_win.block_mouse_buttons = 1;
+    }
+    if (start_event || (start && !s_pc_win.start_down)) s_pc_win.allow_capture = 0;
+    s_pc_win.toggle_down = toggle; s_pc_win.start_down = start;
+    ULONGLONG now = GetTickCount64();
+    float seconds = s_pc_win.last_ms ? (float)(now - s_pc_win.last_ms) / 1000.f : 0;
+    float dx = 0, dy = 0;
+    RECT rect;
+    POINT a = {0,0}, b;
+    if (s_pc_win.config.mouse_enabled && s_pc_win.allow_capture && GetClientRect(window, &rect) &&
+        rect.right > 1 && rect.bottom > 1) {
+        b.x = rect.right; b.y = rect.bottom;
+        if (ClientToScreen(window, &a) && ClientToScreen(window, &b)) {
+            RECT clip = {a.x, a.y, b.x, b.y};
+            POINT center = {(a.x + b.x)/2, (a.y + b.y)/2}, pos;
+            int moved = center.x != s_pc_win.center.x || center.y != s_pc_win.center.y;
+            if (pad_pc_win_captured() && !moved && !warmup && seconds > 0 && seconds <= .25f && GetCursorPos(&pos)) {
+                dx = (float)(pos.x - center.x); dy = (float)(pos.y - center.y);
+            }
+            if (!pad_pc_win_captured() || memcmp(&clip, &s_pc_win.clip, sizeof(clip))) {
+                if (!ClipCursor(&clip)) s_pc_win.allow_capture = 0;
+            }
+            if (s_pc_win.allow_capture && SetCursorPos(center.x, center.y)) {
+                InterlockedExchange(&s_pc_win.captured, 1);
+                s_pc_win.clip = clip; s_pc_win.center = center;
+                SetCursor(NULL);
+            } else { ClipCursor(NULL); pad_pc_win_release_locked(); dx = dy = 0; }
+        } else pad_pc_win_release_locked();
+    } else pad_pc_win_release_locked();
+    s_pc_win.last_ms = now;
+    if (s_pc_win.block_mouse_buttons) {
+        const int mouse[] = {VK_LBUTTON,VK_RBUTTON,VK_MBUTTON,VK_XBUTTON1,VK_XBUTTON2};
+        int held = 0;
+        for (int i = 0; i < 5; ++i) {
+            held |= (GetAsyncKeyState(mouse[i]) & 0x8000) != 0;
+            keys[mouse[i]] = 0;
+            InterlockedAnd(&s_pc_pending[0], (LONG)~(1u << mouse[i]));
+        }
+        if (!held) s_pc_win.block_mouse_buttons = 0;
+    }
+    /* Info polling must not erase motion before GetData can deliver it. Use
+     * displacement/time since the last consumed report, not one 4ms sample. */
+    if (!s_pc_win.report_ms) s_pc_win.report_ms = now;
+    s_pc_win.mouse_dx += dx; s_pc_win.mouse_dy += dy;
+    pad_pc_win_evaluate_locked(out);
+    ReleaseSRWLockExclusive(&s_pc_lock);
+}
+
+#endif

+/* lv2's SPU-side sys_spu_thread_receive_event / tryreceive (stop 0x110 /
+ * 0x111) take one event off the queue the SPU thread bound with
+ * sys_spu_thread_bind_queue. Runs on the SPU's host thread. block=1 waits for
+ * an event. Returns CELL_OK, CELL_EBUSY (try on an empty queue), CELL_ESRCH or
+ * CELL_ECANCELED. */
+int32_t sys_event_queue_pop_for_spu(uint32_t queue_id, int block, sys_event_t* out)
+{
+    if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX)
+        return (int32_t)CELL_ESRCH;
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active)
+        return (int32_t)CELL_ESRCH;
+
+    int32_t rc = CELL_OK;
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+    while (block && q->count == 0 && q->active && !q->cancelled)
+        SleepConditionVariableCS(&q->not_empty, &q->lock, INFINITE);
+#else
+    pthread_mutex_lock(&q->lock);
+    while (block && q->count == 0 && q->active && !q->cancelled)
+        pthread_cond_wait(&q->not_empty, &q->lock);
+#endif
+    if (q->count > 0) {
+        *out = q->buffer[q->head];
+        q->head = (q->head + 1) % q->capacity;
+        q->count--;
+    } else {
+        rc = q->cancelled ? (int32_t)CELL_ECANCELED
+           : !q->active   ? (int32_t)CELL_ESRCH
+                          : (int32_t)CELL_EBUSY;
+    }
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+    return rc;
+}

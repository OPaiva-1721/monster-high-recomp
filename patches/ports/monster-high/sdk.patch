diff --git a/tests/test_sync_queue_wait.c b/tests/test_sync_queue_wait.c
new file mode 100644
index 0000000..fea2078
--- /dev/null
+++ b/tests/test_sync_queue_wait.c
@@ -0,0 +1,97 @@
+/* Windows regression: blocking queue wakeup, FIFO and idle CPU usage.
+ * Pass a private scratch guest memory region; no game data is needed. */
+#include <windows.h>
+#include "../libs/sync/cellSync.c"
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+static CRITICAL_SECTION coherence;
+void spu_lockline_lock(void) { EnterCriticalSection(&coherence); }
+void spu_lockline_unlock(void) { LeaveCriticalSection(&coherence); }
+int spu_coh_is_reserved(uint32_t ea) { (void)ea; return 0; }
+void spu_coh_notify_write(uint32_t ea) { (void)ea; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a,uint64_t v,int w) { (void)a;(void)v;(void)w; }
+static HANDLE entered;
+static s32 result;
+static int operation;
+static DWORD WINAPI consume(void* unused)
+{
+    (void)unused;
+    SetEvent(entered);
+    if(operation==1) result=cellSyncQueuePeek((void*)0x100,(void*)0x400);
+    else if(operation==2) result=cellSyncQueuePush((void*)0x100,(void*)0x350);
+    else result=cellSyncQueuePop((void*)0x100,(void*)0x400);
+    return 0;
+}
+static uint64_t filetime(FILETIME ft)
+{ return ((uint64_t)ft.dwHighDateTime<<32)|ft.dwLowDateTime; }
+int main(void)
+{
+    InitializeCriticalSection(&coherence);
+    vm_base=calloc(1,0x10000); assert(vm_base);
+    assert(cellSyncQueueInitialize((void*)0x100,(void*)0x1000,16,2)==CELL_OK);
+    assert(cellSyncQueueTryPop((void*)0x100,(void*)0x400)==CELL_SYNC_ERROR_BUSY);
+    entered=CreateEventW(NULL,TRUE,FALSE,NULL); assert(entered);
+    HANDLE thread=CreateThread(NULL,0,consume,NULL,0,NULL); assert(thread);
+    assert(WaitForSingleObject(entered,1000)==WAIT_OBJECT_0);
+    Sleep(250);
+    assert(WaitForSingleObject(thread,0)==WAIT_TIMEOUT); /* still waiting, not fake success */
+    FILETIME created,ended,kernel,user;
+    assert(GetThreadTimes(thread,&created,&ended,&kernel,&user));
+    double cpu_ms=(filetime(kernel)+filetime(user))/10000.0;
+    for(int i=0;i<16;i++)vm_base[0x300+i]=(uint8_t)(i+17);
+    assert(cellSyncQueueTryPush((void*)0x100,(void*)0x300)==CELL_OK);
+    assert(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0 && result==CELL_OK);
+    assert(!memcmp(vm_base+0x300,vm_base+0x400,16));
+    assert(cellSyncQueueTryPop((void*)0x100,(void*)0x400)==CELL_SYNC_ERROR_BUSY);
+    /* Wrap the ring several times and preserve exact order. */
+    for(int round=0;round<32;round++) {
+        vm_base[0x300]=(uint8_t)(round*2);
+        assert(cellSyncQueuePush((void*)0x100,(void*)0x300)==CELL_OK);
+        vm_base[0x300]=(uint8_t)(round*2+1);
+        assert(cellSyncQueuePush((void*)0x100,(void*)0x300)==CELL_OK);
+        assert(cellSyncQueueTryPush((void*)0x100,(void*)0x300)==CELL_SYNC_ERROR_BUSY);
+        assert(cellSyncQueuePop((void*)0x100,(void*)0x400)==CELL_OK);
+        assert(vm_base[0x400]==round*2);
+        assert(cellSyncQueuePop((void*)0x100,(void*)0x400)==CELL_OK);
+        assert(vm_base[0x400]==round*2+1);
+    }
+    CloseHandle(thread);
+    operation=1; ResetEvent(entered);
+    thread=CreateThread(NULL,0,consume,NULL,0,NULL); assert(thread);
+    assert(WaitForSingleObject(entered,1000)==WAIT_OBJECT_0);
+    Sleep(50); assert(WaitForSingleObject(thread,0)==WAIT_TIMEOUT);
+    vm_base[0x300]=77;
+    assert(cellSyncQueuePush((void*)0x100,(void*)0x300)==CELL_OK);
+    assert(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0 && result==CELL_OK);
+    assert(vm_base[0x400]==77);
+    assert(cellSyncQueueTryPop((void*)0x100,(void*)0x400)==CELL_OK);
+    assert(vm_base[0x400]==77); /* Peek did not consume. */
+    CloseHandle(thread);
+    vm_base[0x300]=81;
+    assert(cellSyncQueuePush((void*)0x100,(void*)0x300)==CELL_OK);
+    vm_base[0x300]=82;
+    assert(cellSyncQueuePush((void*)0x100,(void*)0x300)==CELL_OK);
+    vm_base[0x350]=83;
+    operation=2; ResetEvent(entered);
+    thread=CreateThread(NULL,0,consume,NULL,0,NULL); assert(thread);
+    assert(WaitForSingleObject(entered,1000)==WAIT_OBJECT_0);
+    Sleep(50); assert(WaitForSingleObject(thread,0)==WAIT_TIMEOUT);
+    assert(cellSyncQueueTryPop((void*)0x100,(void*)0x400)==CELL_OK);
+    assert(vm_base[0x400]==81);
+    assert(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0 && result==CELL_OK);
+    assert(cellSyncQueueTryPop((void*)0x100,(void*)0x400)==CELL_OK);
+    assert(vm_base[0x400]==82);
+    assert(cellSyncQueueTryPop((void*)0x100,(void*)0x400)==CELL_OK);
+    assert(vm_base[0x400]==83);
+    const char* mode=getenv("SYNC_QUEUE_SLEEP");
+    int enabled=mode && !strcmp(mode,"1");
+    printf("queue FIFO/wakeup PASS; sleeping=%d idle consumer CPU=%.2fms over 250ms\n",enabled,cpu_ms);
+    CloseHandle(thread);CloseHandle(entered);free(vm_base);
+    DeleteCriticalSection(&coherence);
+    if(enabled && cpu_ms>100) { puts("FAIL: idle consumer still spins"); return 1; }
+    return 0;
+}

+/* CellSailGraphicsFrameInfo: { u32 pBuffer; u32 sessionId; u32 tag;
+ * s32 status; u64 pts; } -- 24 bytes. */
+s32 cellSailGraphicsAdapterGetFrame(u32 pSelf, u32 pInfo)
+{
+    SAIL_TRACE();
+    (void)pSelf;
+    if (!pInfo) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    sail_zero_guest(pInfo, 24);
+    if (!s_ga.ready || s_ga.eos) return CELL_OK;
+    /* Decode latency: the real player's first picture comes a few hundred ms
+     * after the stream opens. Naruto Storm builds the story scene's 2D display
+     * in that window; a frame on the very first poll made its movie path draw
+     * through the previous scene's destroyed display object. */
+    { static long lat = -1; if (lat < 0) { const char* e = getenv("PS3_SAIL_FIRST_FRAME_MS"); lat = e ? atol(e) : 500; }

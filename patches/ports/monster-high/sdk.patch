+s32 cellSailGraphicsAdapterGetFormat(u32 pSelf, u32 pFormat)
+{
+    SAIL_TRACE();
+    (void)pSelf;
+    if (!pFormat) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    for (u32 i = 0; i < 8; i++) vm_write32(pFormat + 4 * i, s_ga_vf[i]);
+    return CELL_OK;
+}

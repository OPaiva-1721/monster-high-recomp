+/* CellSailFuture: how a title waits for an asynchronous player call. The
+ * player runs every call synchronously and its completion handler sets the
+ * future before Get is reached, so Get only has to hand back the result. The
+ * guest struct is opaque; state is kept here, keyed by its EA. */
+#define SAIL_FUTURE_MAX 16
+static struct { u32 ea; int done; s32 result; } s_sail_futures[SAIL_FUTURE_MAX];
+
+static int sail_future_slot(u32 ea, int create)
+{
+    for (int i = 0; i < SAIL_FUTURE_MAX; i++)
+        if (s_sail_futures[i].ea == ea) return i;
+    if (!create) return -1;
+    for (int i = 0; i < SAIL_FUTURE_MAX; i++)
+        if (!s_sail_futures[i].ea) { s_sail_futures[i].ea = ea; return i; }
+    return -1;
+}
+
+/* NID 0x4CC54F8E */
+s32 cellSailFutureInitialize(u32 pSelf)
+{
+    SAIL_TRACE();
+    const int i = sail_future_slot(pSelf, 1);
+    if (i < 0) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    s_sail_futures[i].done = 0;
+    s_sail_futures[i].result = 0;
+    return CELL_OK;
+}
+
+/* NID 0x9553AF65 */
+s32 cellSailFutureFinalize(u32 pSelf)
+{
+    SAIL_TRACE();
+    const int i = sail_future_slot(pSelf, 0);
+    if (i >= 0) s_sail_futures[i].ea = 0;
+    return CELL_OK;
+}
+
+/* NID 0x0C4CB439 */
+s32 cellSailFutureReset(u32 pSelf, u32 wait)
+{
+    SAIL_TRACE();
+    (void)wait;
+    const int i = sail_future_slot(pSelf, 1);
+    if (i < 0) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    s_sail_futures[i].done = 0;
+    return CELL_OK;
+}
+
+/* NID 0xA37FED15 */
+s32 cellSailFutureSet(u32 pSelf, s32 result)
+{
+    SAIL_TRACE();
+    const int i = sail_future_slot(pSelf, 1);
+    if (i < 0) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    s_sail_futures[i].result = result;
+    s_sail_futures[i].done = 1;
+    return CELL_OK;
+}
+
+/* NID 0x3A2D806C: (pSelf, timeout, s32* pResult) */
+s32 cellSailFutureGet(u32 pSelf, u64 timeout, u32 pResult)
+{
+    SAIL_TRACE();
+    (void)timeout;
+    const int i = sail_future_slot(pSelf, 0);
+    const s32 r = (i >= 0 && s_sail_futures[i].done) ? s_sail_futures[i].result : 0;
+    if (pResult) vm_write32(pResult, (u32)r);
+    return CELL_OK;
+}
+
+/* NID 0x51ECF361: (pSelf, s32* pResult) */
+s32 cellSailFutureIsDone(u32 pSelf, u32 pResult)
+{
+    SAIL_TRACE();
+    const int i = sail_future_slot(pSelf, 0);
+    if (pResult) vm_write32(pResult, i >= 0 ? (u32)s_sail_futures[i].result : 0);
+    return (i >= 0 && s_sail_futures[i].done) ? 1 : 0;
+}

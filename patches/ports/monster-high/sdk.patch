+/* A plan is a snapshot of array formats, defaults and address/frequency state.
+ * Rebuild for every command packet; it never caches guest bytes across draws.
+ * MAIN mappings are linear within each 1 MiB IO page (cellGcmSys.c). Cache
+ * only the initial page; another page always goes through the resolver. */
+typedef struct rsx_vp_fetch_array {
+    u32 slot, offset, stride, type, size, frequency, modulo, local;
+    u32 resolved_base;
+    u32 crank;          /* slot in the compact vertex (rank of `slot` in the input mask) */
+} rsx_vp_fetch_array;
+typedef struct rsx_vp_fetch_plan {
+    float defaults[16][4];
+    /* Compact vertex: nslots float4, slot r = r-th set bit (bit[r]) of the input mask. */
+    u32 nslots; u8 bit[16]; float cdefaults[16][4];
+    rsx_vp_fetch_array arrays[16];
+    u32 count;
+} rsx_vp_fetch_plan;
+void rsx_vp_fetch_plan_init(const rsx_state* st, u32 input_mask, rsx_vp_fetch_plan* plan);
+void rsx_fetch_vertex_planned(const rsx_vp_fetch_plan* plan, u32 vi, float out[16][4]);
+/* Same 256-byte layout, consecutive indices; bounded staging keeps upload
+ * writes sequential even when the destination is write-combined memory. */
+void rsx_fetch_vertices_planned(const rsx_vp_fetch_plan* plan, u32 first, u32 count,
+                               float (*out)[16][4]);
+
+/* Small worker pool for the vertex decode of big draws. rsx_par_workers() is the total thread
+ * count including the caller (0 or 1 = run serially); rsx_par_for runs fn(ctx, 0..nchunks-1)
+ * across them and returns when all chunks are done. RSX_PAR=<n> sets it, 0 turns it off. */
+/* Compact forms: the vertex is plan->nslots float4 (see rsx_vp_fetch_plan), decoded straight into
+ * its slots with no 16-slot temporary. rsx_fetch_vertices_compact writes count vertices
+ * contiguously (count * nslots float4). */
+/* Copy n float4 slots; a loop of 16-byte moves, because a variable-length memcpy is a library call
+ * and this runs once per vertex. */
+#if defined(__SSE2__)
+#include <emmintrin.h>
+static inline void rsx_copy_slots(void* dst, const void* src, u32 n)
+{
+    __m128i* d = (__m128i*)dst; const __m128i* s = (const __m128i*)src;
+    for (u32 r = 0; r < n; ++r) _mm_storeu_si128(d + r, _mm_loadu_si128(s + r));
+}
+#else
+#include <string.h>
+static inline void rsx_copy_slots(void* dst, const void* src, u32 n) { memcpy(dst, src, (size_t)n * 16u); }
+#endif
+void rsx_fetch_vertex_compact(const rsx_vp_fetch_plan* plan, u32 vi, float (*out)[4]);
+void rsx_fetch_vertices_compact(const rsx_vp_fetch_plan* plan, u32 first, u32 count, float* out);
+/* As rsx_fetch_vertices_compact for an arbitrary list of vertex indices (distinct or not):
+ * out[i] = vertex idx[i], count * nslots float4. Arrays are decoded one at a time over the whole
+ * block, so the per-type switch runs once per array instead of once per vertex. */
+void rsx_fetch_vertices_gather(const rsx_vp_fetch_plan* plan, const u32* idx, u32 count, float* out);
+int rsx_par_workers(void);
+void rsx_par_for(void (*fn)(void* ctx, u32 chunk), void* ctx, u32 nchunks);
+
 #ifdef __cplusplus
 }
 #endif

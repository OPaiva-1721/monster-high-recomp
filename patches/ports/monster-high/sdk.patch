diff --git a/runtime/ppu/ppu_fastmem.h b/runtime/ppu/ppu_fastmem.h
new file mode 100644
index 0000000..6ff42a2
--- /dev/null
+++ b/runtime/ppu/ppu_fastmem.h
@@ -0,0 +1,100 @@
+/* Experimental helpers embedded in ppu_recomp.h by ppu_lifter.py --fast-mem.
+ * Include AFTER the normal generated header declarations / inline loads.
+ * VM base, size and HLE injection base are fixed before guest threads start;
+ * never cache SPU reservation state or the self-arming barrier watch.
+ * No fixed host register is reserved: LLVM can keep this function-local view
+ * in registers on both AArch64 and x64 without changing the guest-call ABI.
+ */
+#ifndef PPU_FASTMEM_H
+#define PPU_FASTMEM_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int vm_fastmem_reads_ok, vm_fastmem_writes_ok;
+extern uint32_t g_barrier_sync_watch;
+int spu_coh_is_reserved(uint32_t addr);
+#ifdef __cplusplus
+}
+#endif
+
+typedef struct ppu_fastmem {
+    uint8_t* base;
+    uint32_t read_span, write_span, ref_poll;
+} ppu_fastmem;
+
+static inline ppu_fastmem ppu_fastmem_begin(void)
+{
+    ppu_fastmem m;
+    uint32_t end = ppu_vm_size;
+    if (!end || end > 0xE0000000u) end = 0xE0000000u;
+    uint32_t span = end >= 0x10000u ? end - 0x10000u : 0;
+    m.base = vm_base;
+    m.read_span = vm_inline_ok && vm_fastmem_reads_ok ? span : 0;
+    m.write_span = vm_fastmem_writes_ok ? span : 0;
+    m.ref_poll = ppu_hle_inject_base + 0x2008u;
+    return m;
+}
+
+/* Unsigned subtraction folds the lower/upper/bounds checks into one range
+ * test. Widen BEFORE adding n: addresses near UINT32_MAX must not wrap in.
+ * A zero span (diagnostic armed) rejects even an EA below the null page. */
+static inline int ppu_fastmem_range(uint32_t ea, uint32_t n, uint32_t span)
+{
+    return (uint64_t)(uint32_t)(ea - 0x10000u) + n <= span;
+}
+
+#ifndef PPU_FASTMEM_DISABLE
+#define PPU_FAST_READ(bits, T, swap)                                           \
+static inline T vm_fast_read##bits(const ppu_fastmem* m, uint64_t a)           \
+{                                                                            \
+    uint32_t ea = (uint32_t)a;                                                \
+    if (__builtin_expect(ppu_fastmem_range(ea, sizeof(T), m->read_span) &&     \
+                         ea != m->ref_poll, 1)) {                             \
+        T raw;                                                               \
+        if (!(ea & (sizeof(T) - 1)))                                          \
+            raw = __atomic_load_n((const T*)(m->base + ea), __ATOMIC_RELAXED); \
+        else memcpy(&raw, m->base + ea, sizeof(T));                           \
+        return swap(raw);                                                    \
+    }                                                                        \
+    return (vm_read##bits)(a);                                                \
+}
+#define PPU_FAST_WRITE(bits, T, swap)                                          \
+static inline void vm_fast_write##bits(const ppu_fastmem* m, uint64_t a, T v)  \
+{                                                                            \
+    uint32_t ea = (uint32_t)a;                                                \
+    if (__builtin_expect(ppu_fastmem_range(ea, sizeof(T), m->write_span) &&    \
+                         !g_barrier_sync_watch, 1) &&                         \
+        !spu_coh_is_reserved(ea)) {                                           \
+        T raw = swap(v);                                                     \
+        if (!(ea & (sizeof(T) - 1)))                                          \
+            __atomic_store_n((T*)(m->base + ea), raw, __ATOMIC_RELAXED);        \
+        else memcpy(m->base + ea, &raw, sizeof(T));                           \
+        return;                                                              \
+    }                                                                        \
+    (vm_write##bits)(a, v);                                                   \
+}
+#else
+/* Same lift, original accessors: convenient A/B without another full relift.
+ * vm_read##bits(a) expands to the ORIGINAL inline-load macro, if enabled. */
+#define PPU_FAST_READ(bits, T, swap)                                           \
+static inline T vm_fast_read##bits(const ppu_fastmem* m, uint64_t a)           \
+{ (void)m; return vm_read##bits(a); }
+#define PPU_FAST_WRITE(bits, T, swap)                                          \
+static inline void vm_fast_write##bits(const ppu_fastmem* m, uint64_t a, T v)  \
+{ (void)m; vm_write##bits(a, v); }
+#endif
+
+#define PPU_FAST_ID(v) (v)
+PPU_FAST_READ(8, uint8_t, PPU_FAST_ID)
+PPU_FAST_READ(16, uint16_t, __builtin_bswap16)
+PPU_FAST_READ(32, uint32_t, __builtin_bswap32)
+PPU_FAST_READ(64, uint64_t, __builtin_bswap64)
+PPU_FAST_WRITE(8, uint8_t, PPU_FAST_ID)
+PPU_FAST_WRITE(16, uint16_t, __builtin_bswap16)
+PPU_FAST_WRITE(32, uint32_t, __builtin_bswap32)
+PPU_FAST_WRITE(64, uint64_t, __builtin_bswap64)
+#undef PPU_FAST_ID
+#undef PPU_FAST_READ
+#undef PPU_FAST_WRITE
+#endif

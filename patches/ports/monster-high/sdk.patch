+/*
+ * PAMF movie playback for the cellSail HLE.
+ *
+ * A PAMF file is an MPEG program stream behind a header of 2048-byte
+ * sectors. The movies this was written for (Naruto Storm's logos, opening and
+ * story cutscenes) carry one MPEG-2 video stream (0xE0) and no audio: the
+ * title plays the soundtrack itself from its own sound banks. So the player
+ * here demuxes 0xE0, decodes it with FFmpeg (loaded at run time, see
+ * ffmpeg_runtime.h), converts each picture to RGBA and hands it to whatever
+ * sink the renderer registered (g_sail_movie_sink), paced at the stream's
+ * frame rate. When the stream ends -- or the title stops the player -- it
+ * calls the completion the cellSail layer passed in, which reports the
+ * session as finished the way the real player does.
+ *
+ * The title's own graphics adapter never sees these frames: the picture goes
+ * straight to the screen. That is enough for full-screen movies.
+ */
+#include "sail_movie.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <process.h>
+#else
+#include <pthread.h>
+#include <time.h>
+#include <unistd.h>
+#endif
+
+void (*g_sail_movie_sink)(const uint8_t* rgba, uint32_t w, uint32_t h) = NULL;
+
+#ifdef PS3RECOMP_FFMPEG_RUNTIME
+#include "ffmpeg_runtime.h"
+
+extern const char* ppu_vfs_root;
+
+typedef struct {
+    char path[1024];
+    int  slot;
+    sail_movie_done_fn done;
+    volatile int cancel;
+    volatile int running;
+} Movie;
+
+static Movie s_mv;
+
+static double now_s(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart / (double)f.QuadPart;
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec + ts.tv_nsec * 1e-9;
+#endif
+}
+
+static void sleep_s(double s)
+{
+    if (s <= 0) return;
+#ifdef _WIN32
+    Sleep((DWORD)(s * 1000.0));
+#else
+    usleep((useconds_t)(s * 1e6));
+#endif
+}
+
+static uint8_t clamp8(int v) { return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+
+/* BT.601 limited-range YUV 4:2:0 -> RGBA. */
+static void yuv_to_rgba(const AVFrame* f, uint8_t* out)
+{
+    const int w = f->width, h = f->height;
+    for (int y = 0; y < h; y++) {
+        const uint8_t* Y = f->data[0] + (size_t)y * f->linesize[0];
+        const uint8_t* U = f->data[1] + (size_t)(y >> 1) * f->linesize[1];
+        const uint8_t* V = f->data[2] + (size_t)(y >> 1) * f->linesize[2];
+        uint8_t* o = out + (size_t)y * w * 4;
+        for (int x = 0; x < w; x++) {
+            int c = 298 * (Y[x] - 16), d = U[x >> 1] - 128, e = V[x >> 1] - 128;
+            o[0] = clamp8((c + 409 * e + 128) >> 8);
+            o[1] = clamp8((c - 100 * d - 208 * e + 128) >> 8);
+            o[2] = clamp8((c + 516 * d + 128) >> 8);
+            o[3] = 255;
+            o += 4;
+        }
+    }
+}
+
+static void movie_run(Movie* m)
+{
+    const PS3FFmpeg* ff = ps3_ffmpeg_get();
+    FILE* fp = ff ? fopen(m->path, "rb") : NULL;
+    if (!fp) {
+        printf("[sail-movie] cannot play %s (%s)\n", m->path, ff ? "open failed" : "no FFmpeg");
+        return;
+    }
+    const AVCodec* codec = ff->avcodec_find_decoder(AV_CODEC_ID_MPEG2VIDEO);
+    AVCodecContext* ctx = codec ? ff->avcodec_alloc_context3(codec) : NULL;
+    AVCodecParserContext* par = ff->av_parser_init(AV_CODEC_ID_MPEG2VIDEO);
+    if (!ctx || !par || ff->avcodec_open2(ctx, codec, NULL) < 0) {
+        printf("[sail-movie] MPEG-2 decoder unavailable\n");
+        if (par) ff->av_parser_close(par);
+        if (ctx) ff->avcodec_free_context(&ctx);
+        fclose(fp);
+        return;
+    }
+    AVPacket* pkt = ff->av_packet_alloc();
+    AVFrame* frm = ff->av_frame_alloc();
+    uint8_t* rgba = NULL; size_t rgba_cap = 0;
+
+    /* Skip the PAMF header: the program stream starts at the first sector
+     * that begins with a pack header. */
+    static uint8_t sec[2048];
+    long start = 0;
+    while (fread(sec, 1, 4, fp) == 4) {
+        if (sec[0] == 0 && sec[1] == 0 && sec[2] == 1 && sec[3] == 0xBA) break;
+        start += 2048;
+        fseek(fp, start, SEEK_SET);
+    }
+    fseek(fp, start, SEEK_SET);
+
+    const double fps_default = 30000.0 / 1001.0;
+    double t0 = 0; long shown = 0;
+    uint8_t* buf = (uint8_t*)malloc(1 << 20);
+    size_t have = 0;
+    int eof = 0;
+    printf("[sail-movie] playing %s\n", m->path);
+
+    while (!m->cancel) {
+        /* Refill: read whole PS packets, keep only 0xE0 PES payloads. */
+        if (!eof && have < (1 << 19)) {
+            uint8_t hdr[6];
+            if (fread(hdr, 1, 4, fp) != 4) { eof = 1; }
+            else if (hdr[0] || hdr[1] || hdr[2] != 1) {
+                /* Lost sync: scan forward one byte at a time. */
+                fseek(fp, -3, SEEK_CUR);
+                continue;
+            } else if (hdr[3] == 0xBA) {                 /* pack header */
+                uint8_t ph[10];
+                if (fread(ph, 1, 10, fp) != 10) { eof = 1; continue; }
+                fseek(fp, ph[9] & 7, SEEK_CUR);           /* stuffing */
+                continue;
+            } else if (hdr[3] == 0xB9) {                 /* program end */
+                eof = 1;
+            } else {
+                if (fread(hdr + 4, 1, 2, fp) != 2) { eof = 1; continue; }
+                const unsigned len = ((unsigned)hdr[4] << 8) | hdr[5];
+                if (hdr[3] == 0xE0 && len >= 3) {
+                    uint8_t* p = (uint8_t*)malloc(len);
+                    if (fread(p, 1, len, fp) != len) { free(p); eof = 1; continue; }
+                    const unsigned hl = 3u + p[2];
+                    if (hl < len) { memcpy(buf + have, p + hl, len - hl); have += len - hl; }
+                    free(p);
+                } else {
+                    fseek(fp, len, SEEK_CUR);
+                }
+            }
+        }
+        if (!have && !eof) continue;
+
+        /* Parse and decode what we have. */
+        uint8_t* out = NULL; int out_size = 0;
+        const int used = ff->av_parser_parse2(par, ctx, &out, &out_size,
+                                              have ? buf : NULL, (int)have,
+                                              AV_NOPTS_VALUE, AV_NOPTS_VALUE, 0);
+        if (used > 0) { memmove(buf, buf + used, have - used); have -= used; }
+        if (out_size > 0) {
+            pkt->data = out; pkt->size = out_size;
+            if (ff->avcodec_send_packet(ctx, pkt) == 0) {
+                while (!m->cancel && ff->avcodec_receive_frame(ctx, frm) == 0) {
+                    const size_t need = (size_t)frm->width * frm->height * 4;
+                    if (need > rgba_cap) { free(rgba); rgba = (uint8_t*)malloc(need); rgba_cap = need; }
+                    if (rgba && frm->format == AV_PIX_FMT_YUV420P) {
+                        yuv_to_rgba(frm, rgba);
+                        double fps = fps_default;
+                        if (ctx->framerate.num > 0 && ctx->framerate.den > 0)
+                            fps = (double)ctx->framerate.num / ctx->framerate.den;
+                        if (!t0) t0 = now_s();
+                        sleep_s(t0 + shown / fps - now_s());
+                        if (g_sail_movie_sink) g_sail_movie_sink(rgba, (uint32_t)frm->width, (uint32_t)frm->height);
+                        shown++;
+                    }
+                    ff->av_frame_unref(frm);
+                }
+            }
+        } else if (eof && used <= 0) {
+            /* Drain the decoder and stop. */
+            if (have == 0) break;
+            have = 0;
+        }
+    }
+    printf("[sail-movie] %s after %ld frames\n", m->cancel ? "stopped" : "finished", shown);
+    if (g_sail_movie_sink) g_sail_movie_sink(NULL, 0, 0);
+    free(buf); free(rgba);
+    ff->av_frame_free(&frm);
+    ff->av_packet_free(&pkt);
+    ff->av_parser_close(par);
+    ff->avcodec_free_context(&ctx);
+    fclose(fp);
+}
+
+#ifdef _WIN32
+static unsigned __stdcall movie_thread(void* arg)
+#else
+static void* movie_thread(void* arg)
+#endif
+{
+    Movie* m = (Movie*)arg;
+    movie_run(m);
+    m->running = 0;
+    if (!m->cancel && m->done) m->done(m->slot);
+    return 0;
+}
+
+int sail_movie_start(const char* uri, int slot, sail_movie_done_fn done)
+{
+    if (s_mv.running) return 0;
+    if (!ps3_ffmpeg_get() || !uri) return 0;
+    const char* p = strstr(uri, "/dev_bdvd/");
+    if (!p) return 0;
+    p += strlen("/dev_bdvd/");
+    const char* root = (ppu_vfs_root && *ppu_vfs_root) ? ppu_vfs_root : ".";
+    memset(&s_mv, 0, sizeof(s_mv));
+    snprintf(s_mv.path, sizeof(s_mv.path), "%s/%s", root, p);
+    FILE* t = fopen(s_mv.path, "rb");
+    if (!t) { printf("[sail-movie] %s not found\n", s_mv.path); return 0; }
+    fclose(t);
+    s_mv.slot = slot; s_mv.done = done; s_mv.running = 1;
+#ifdef _WIN32
+    HANDLE h = (HANDLE)_beginthreadex(NULL, 0, movie_thread, &s_mv, 0, NULL);
+    if (!h) { s_mv.running = 0; return 0; }
+    CloseHandle(h);
+#else
+    pthread_t th;
+    if (pthread_create(&th, NULL, movie_thread, &s_mv) != 0) { s_mv.running = 0; return 0; }
+    pthread_detach(th);
+#endif
+    return 1;
+}
+
+void sail_movie_stop(void)
+{
+    if (!s_mv.running) return;
+    s_mv.cancel = 1;
+    for (int i = 0; i < 200 && s_mv.running; i++) sleep_s(0.005);
+}
+
+int sail_movie_playing(void) { return s_mv.running; }
+
+#else  /* !PS3RECOMP_FFMPEG_RUNTIME */
+
+int  sail_movie_start(const char* uri, int slot, sail_movie_done_fn done)
+{ (void)uri; (void)slot; (void)done; return 0; }
+void sail_movie_stop(void) {}
+int  sail_movie_playing(void) { return 0; }
+
+#endif

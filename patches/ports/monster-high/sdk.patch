+    const char* trigger = getenv("RSX_PASS_TRIGGER");
+    if (!trigger || !*trigger || s_pass_probe.armed) return;
+    FILE* f = fopen(trigger, "r");
+    if (!f) return;
+    memset(&s_pass_probe, 0, sizeof s_pass_probe);
+    char token[32];
+    while (s_pass_probe.nfp < 8 && fscanf(f, "%31s", token) == 1)
+        s_pass_probe.fps[s_pass_probe.nfp++] = (u32)strtoul(token, NULL, 0);
+    fclose(f);
+    int matches=0;
+    for(u32 d=0;d<s_d3d.draw_count && !matches;++d)
+        for(u32 i=0;i<s_pass_probe.nfp;++i)
+            if(!s_d3d.draws[d].is_clear && s_d3d.draws[d].fp_addr==s_pass_probe.fps[i]) matches=1;
+    if(!matches) return; /* leave the trigger for a relevant submission */
+    const char* dir = getenv("RSX_PASS_DIR");
+    snprintf(s_pass_probe.dir, sizeof s_pass_probe.dir, "%s", dir && *dir ? dir : "pass-probe");
+    CreateDirectoryA(s_pass_probe.dir, NULL);
+    s_pass_probe.armed = s_pass_probe.nfp != 0;
+    if (!s_pass_probe.armed) fprintf(stderr,"[PASS-PROBE] empty selector file\n");
+    DeleteFileA(trigger);
+}
+
+static void pass_probe_copy(u32 op, const D3D12DrawRecord* dr, int rt, int after)
+{
+    if (!s_pass_probe.armed || rt < 0 || s_pass_probe.count >= 16) return;
+    u32 i;
+    for (i=0; i<s_pass_probe.nfp; ++i)
+        if (dr->fp_addr == s_pass_probe.fps[i]) break;
+    if (i == s_pass_probe.nfp || (s_pass_probe.seen & (1u<<i))) return;
+    if (after) s_pass_probe.seen |= 1u<<i;
+    OffRT* r = &s_d3d.off_rt[rt];
+    if (r->dxgi != DXGI_FORMAT_R8G8B8A8_UNORM) {
+        s_pass_probe.failed=1; return; /* explicit unsupported format */
+    }
+    PassProbeCopy* c = &s_pass_probe.copies[s_pass_probe.count];
+    c->w=r->w; c->h=r->h; c->format=r->dxgi; c->pitch=(r->w*4+255)&~255u;
+    c->op=op; c->fp=dr->fp_addr; c->off=r->off; c->after=after;
+    D3D12_HEAP_PROPERTIES hp={0}; hp.Type=D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd={0}; rd.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width=(u64)c->pitch*c->h; rd.Height=1; rd.DepthOrArraySize=1;
+    rd.MipLevels=1; rd.SampleDesc.Count=1; rd.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    HRESULT hr=s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device,&hp,
+        D3D12_HEAP_FLAG_NONE,&rd,D3D12_RESOURCE_STATE_COPY_DEST,NULL,
+        &IID_ID3D12Resource,(void**)&c->res);
+    if (FAILED(hr)) {s_pass_probe.failed=1; return;}
+    D3D12_RESOURCE_STATES previous=r->st;
+    off_rt_transition(rt,D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION dst={0},src={0};
+    dst.pResource=c->res; dst.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format=(DXGI_FORMAT)c->format;
+    dst.PlacedFootprint.Footprint.Width=c->w; dst.PlacedFootprint.Footprint.Height=c->h;
+    dst.PlacedFootprint.Footprint.Depth=1; dst.PlacedFootprint.Footprint.RowPitch=c->pitch;
+    src.pResource=r->res; src.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list,&dst,0,0,0,&src,NULL);
+    off_rt_transition(rt,previous);
+    ++s_pass_probe.count;
+}
+
+static void pass_probe_finish(void)
+{
+    if (!s_pass_probe.armed) return;
+    wait_for_gpu(); /* after the ORIGINAL submission, never between draws */
+    char path[512];
+    snprintf(path,sizeof path,"%s/manifest.txt",s_pass_probe.dir);
+    FILE* manifest=fopen(path,"w");
+    if (manifest) fprintf(manifest,"frame=%llu copies=%u failed=%d matched=0x%X expected=0x%X\n",
+        (unsigned long long)s_d3d.frame_count,s_pass_probe.count,s_pass_probe.failed,
+        s_pass_probe.seen,(1u<<s_pass_probe.nfp)-1);
+    for (u32 i=0;i<s_pass_probe.count;++i) {
+        PassProbeCopy* c=&s_pass_probe.copies[i];
+        snprintf(path,sizeof path,"%s/op%03u_%08X_%s.bmp",s_pass_probe.dir,c->op,c->fp,c->after?"after":"before");
+        void* mapped=NULL;
+        D3D12_RANGE range={0,(SIZE_T)c->pitch*c->h};
+        HRESULT hr=c->res->lpVtbl->Map(c->res,0,&range,&mapped);
+        if (SUCCEEDED(hr)) {
+            cap_write_bmp(path,mapped,c->w,c->h,c->pitch,c->format);
+            D3D12_RANGE written={0,0};c->res->lpVtbl->Unmap(c->res,0,&written);
+        }
+        if(manifest) fprintf(manifest,"op=%u fp=0x%08X rt=0x%08X phase=%s map=0x%08lX\n",
+            c->op,c->fp,c->off,c->after?"after":"before",(unsigned long)hr);
+        c->res->lpVtbl->Release(c->res);
+    }
+    if(manifest) fclose(manifest);
+    fprintf(stderr,"[PASS-PROBE] frame=%llu copies=%u -> %s\n",
+        (unsigned long long)s_d3d.frame_count,s_pass_probe.count,s_pass_probe.dir);
+    s_pass_probe.armed=0;
+}

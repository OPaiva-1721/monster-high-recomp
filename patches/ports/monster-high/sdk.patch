+ * update routine (0x00682A80) matched a GetFrame buffer against one of the
+ * textures its alloc callback created (it stores the texture id at adapter
+ * arg+0x16C). With no callbacks and no GetFrame that never happens, the script
+ * never reaches its "Now Loading" step, and the village is never loaded.
+ * The picture itself is still shown by the host overlay (sail_movie.c); here
+ * the title only needs a valid frame handed back. One adapter is enough.
+ * -----------------------------------------------------------------------*/
+void* _sys_memalign(u32 align, u32 size);
+static struct { u32 self, arg, cb[5], mem, sid; int bound, made, ready, eos; unsigned long long t_open; } s_ga;
+/* CellSailVideoFormat (32 bytes, big-endian): coding 0 (ARGB), progressive,
+ * 8 bits/colour, 30 Hz, 1280x720, pitch 5120, alpha 255, BT.709, square. */
+static const u32 s_ga_vf[8] = { 0x00000804u, 0x050002D0u, 5120u, 255u,
+                                0x010100FFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu };
+#define GA_CB(i, a, b, c, d) do { if (s_ga.cb[i] && g_ps3_guest_caller) \
+    g_ps3_guest_caller(s_ga.cb[i], (a), (b), (c), (d), 0, 0, 0, 0); } while (0)
+
+static void ga_bind(u32 self, u32 funcs, u32 arg)
+{
+    memset(&s_ga, 0, sizeof s_ga);
+    if (!funcs) return;
+    s_ga.self = self; s_ga.arg = arg;
+    for (u32 i = 0; i < 5; i++) s_ga.cb[i] = vm_read32(funcs + 4 * i);
+    s_ga.bound = 1;
+}
+
+static void ga_makeup(void)
+{
+    if (!s_ga.bound || s_ga.made) return;
+    GA_CB(0, s_ga.arg, 0, 0, 0);
+    s_ga.made = 1;
+}
+
+/* Before RUNNING: let the title create its frame textures (alloc asks
+ * GetFormat itself), then report the format. */
+static void ga_open(void)
+{
+    if (!s_ga.bound || s_ga.ready) return;
+    ga_makeup();
+    if (!s_ga.mem) s_ga.mem = (u32)(uintptr_t)_sys_memalign(16, 64);
+    if (!s_ga.mem) return;
+    sail_zero_guest(s_ga.mem, 64);
+    for (u32 i = 0; i < 8; i++) vm_write32(s_ga.mem + 4 * i, s_ga_vf[i]);
+    GA_CB(3, s_ga.arg, 1280u * 720u * 4u, 3, s_ga.mem + 32);   /* alloc: 3 frames */
+    GA_CB(2, s_ga.arg, s_ga.mem, ++s_ga.sid, 0);               /* formatChanged */
+    s_ga.ready = 1; s_ga.eos = 0; s_ga.t_open = GetTickCount64();
+    { static int _n = 0; if (_n++ < 4)
+        printf("[cellSail] graphics adapter ready: mem=0x%08X frame0=0x%08X sid=%u\n",
+               s_ga.mem, vm_read32(s_ga.mem + 32), s_ga.sid); }
+}
+
+/* End of stream: the real player has no more pictures to hand out. Naruto
+ * Storm keeps polling GetFrame from its movie update; handing it the last
+ * frame forever kept that path drawing through the logo scene's 2D display
+ * object after the scene had destroyed it (null vtable call, 0x001F2A4C). */
+static void ga_eos(void) { s_ga.eos = 1; }
+
+static void ga_close(void)
+{
+    if (!s_ga.ready) return;
+    s_ga.ready = 0;
+    GA_CB(4, s_ga.arg, 3, s_ga.mem + 32, 0);                   /* free */
+}
+
+static void ga_finalize(void)
+{
+    ga_close();
+    if (s_ga.made) GA_CB(1, s_ga.arg, 0, 0, 0);                /* cleanup */
+    s_ga.made = 0;
